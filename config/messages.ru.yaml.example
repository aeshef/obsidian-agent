# cp config/messages.ru.yaml.example → config/messages.ru.yaml
# Telegram UI strings (Russian). English: messages.en.yaml.example
# Production copy with your wording: messages.ru.yaml (gitignored).

common:
  need_start: "Сначала нажмите /start"
  need_start_short: "Сначала /start"
  cancelled: "Отменено."
  cancel_button: "❌ Отмена"
  error: "❌ Ошибка: {error}"
  error_generic: "Ошибка"
  account_not_found: "Счёт не найден"
  account_currency_mismatch: "Валюта счёта {account_currency} не совпадает с валютой долга {currency}"

host:
  back_home: "🏠 Главное"
  mode_auto: "💬 Чат (авто)"
  mode_finance: "💰 Финансы"
  mode_planning: "📋 Планирование"
  mode_knowledge: "📚 База знаний"
  start_welcome: |
    👋 Assistant — один бот на всё.

    • Выбери режим кнопкой (финансы / план / знания) — появится привычное меню
    • Или «💬 Чат (авто)» — только переписка, домен сам
    • /memory — память · /reset — сброс диалога
  domain_current: "Режим: {mode}. Или кнопками: {finance} / {planning}"
  domain_invalid: "Допустимо: finance, planning, knowledge, auto"
  main_menu: "🏠 Главное меню"
  history_cleared: "🧹 История очищена."
  planning_unavailable: |
    ⚠️ Модуль планирования не загрузился (см. unified_bot.log).
    Попробуйте позже или режим {finance} / {knowledge}.
  planning_unavailable_short: "⚠️ Модуль планирования недоступен."
  planning_callback_unavailable: "Планирование недоступно"
  llm_routing_failed: "❌ LLM недоступен или вернул невалидный ответ: {error}"
  agent_error: "❌ Ошибка агента: {error}"
  switch_finance: "💰 Режим финансов. Кнопки — как в finance-боте; свободный текст — расход/доход или вопрос."
  switch_planning: "📋 Режим планирования. Кнопки — как в planning-боте; текст — задача или вопрос."
  switch_knowledge: |
    📚 Режим базы знаний.
    • «📥 Прогрузка ВКЛ» — пачка видео/фото с автосохранением
    • «🔍 Вопрос к базе» — поиск по заметкам текстом
    • Обычное медиа без прогрузки — ревью и «💾 Сохранить»
  switch_auto: "💬 Авто: домен по смыслу сообщения. Кнопки доменов — через 🏠 Главное."
  placeholder_root: "Выбери режим или напиши вопрос"
  placeholder_knowledge: "Прогрузка медиа или вопрос по заметкам"
  placeholder_auto: "Вопрос — домен выберется сам"

wire:
  voice_transcribing: "🎤 Распознаю речь..."
  voice_failed: "❌ Не удалось распознать речь."
  voice_preview: '🎤 Распознал: "{preview}"'
  voice_llm_failed: "❌ LLM недоступен: {error}"
  voice_error: "❌ Ошибка обработки голоса:\n\n{error}"

agent:
  tool_not_allowed: "Инструмент {name} не в списке для этого запроса. Доступны: {allowed}{ellipsis}"
  tool_error: "Ошибка инструмента {name}: {error}"
  no_answer: "Не удалось получить ответ."
  max_iters_reached: "Не удалось завершить анализ за отведённое число шагов."
  progress_line: "Шаг {step}: {tools}{tail}"
  progress_empty_tools: "…"
  date_hint: "Сегодня: {date}."
  host_followup_hint: |
    Если пользователь уточняет прошлый ответ («в смысле…», «нет, про…», «а вчера»), сохраняй тему последнего ответа и тот же домен (задачи/финансы/знания), пока явно не попросили другое.

memory:
  title: "🧠 Память агента"
  pending_header: "Ожидают подтверждения:"
  no_pending: "Нет кандидатов на подтверждение."
  confirmed_header: "Подтверждённые наблюдения:"
  no_confirmed: "Подтверждённых наблюдений пока нет."
  confirm_hint: "Подтверди или отклони кандидата кнопками ниже."
  pending_line: "• [{domain}] #{id}: {text} (×{count})"
  confirmed_line: "• {text}"
  confirm_btn: "✅ #{id}"
  reject_btn: "❌ #{id}"
  invalid_id: "Некорректный id"
  saved: "Сохранено в память"
  not_found: "Не найдено"
  open_memory: "Открой /memory в чате"
  rejected: "Отклонено"

synth:
  remember_btn: "✅ Запомнить"
  reject_btn: "❌ Нет"
  pattern_ready: |
    🧠 [{domain}] Паттерн готов к сохранению:

    {pattern}

    Подтвердить?

memory_context:
  finance_header: "Домен: finance. Период анализа: последние ~{days} дней (агрегаты ниже)."
  planning_header: "Домен: planning. Период: последние события и снимок доски."
  knowledge_header: "Домен: knowledge. Заметок в индексе: {count}. Vault: {vault_name}."
  recent_dialogue: "Недавний диалог:\n{lines}"

knowledge:
  query_prompt: "🔍 Напиши следующим сообщением вопрос по базе (только текст, без вложений)."
  buttons:
    bulk_on: "📥 Прогрузка ВКЛ"
    bulk_off: "📤 Прогрузка ВЫКЛ"
    query: "🔍 Вопрос к базе"
    query_legacy: "🔍 Спросить базу знаний"
    preview_save: "💾 Сохранить"
    preview_type: "🏷 Тип"
    preview_cancel: "✖️ Отмена"
  bulk_enabled: |
    📥 Прогрузка включена.

    Шли фото/видео — сохраню автоматически (ASR, тип, теги).
    Прогресс в чате; выключить: «📤 Прогрузка ВЫКЛ» или /bulk_off.
  bulk_disabled: |
    📤 Прогрузка выключена.
    За сессию: сохранено {saved}, ошибок {failed}.
    Снова обычный режим — ревью и кнопка «💾 Сохранить».
  searching: "🧠 Ищу в базе заметок…"
  access_denied: "⛔️ Доступ запрещён"
  ingest_hint: |
    Пришли ссылку, текст или медиа — оформлю заметку.
    Вопрос по сохранённому — текст без вложений или кнопка «🔍 Вопрос к базе».
  greeting: |
    Привет! Вопрос по сохранённым заметкам — сформулируй тему;
    чтобы сохранить новое — пришли ссылку, текст или медиа.
  bulk_processing: "⏳ Прогрузка: принял, обрабатываю…"
  bulk_error: "❌ Ошибка прогрузки: {error}"
  processing: "⏳ Обрабатываю..."
  query_error: "Ошибка запроса к базе: {error}"
  cancelled: "Отменено."
  pick_type_page: "Выбрать тип (страница {page}):"
  pick_type_page_total: "Выбрать тип (страница {page}/{total}):"
  bulk_hint_on: |
    📥 «Прогрузка ВКЛ» — пачка видео/фото с автосохранением (без ревью на каждый файл).
  bulk_hint_active: |
    📥 Сейчас включена прогрузка — шли медиа; выключить: «Прогрузка ВЫКЛ».
  pending_data_lost: "Нет данных (сообщение вычищено из очереди: лимит {limit}). Перешли файл заново или задай PENDING_LIMIT в .env"
  save_error: "Ошибка при создании заметки"
  note_created: "✅ Создано: {path}\nТип: {type}"
  preview_ready: "Готово к сохранению — тип: {type}\nНазвание: {title}"
  preview_ready_fallback: "Готово к сохранению — тип: {type}\nНазвание: {title}"
  type_updated: "Тип обновлён"
  back_button: "🔙 Назад"
  bulk_skip_empty: |
    ❌ Прогрузка: не сохраняю ({failed}) — видео >20 МБ у Bot API, превью не скачалось или нет подписи/ASR. Перешли как файл (<20 МБ), фото, аудио или ссылку на ролик.
  bulk_saved_ack: "✅ Прогрузка {saved}: {title}\n{path}"
  bulk_save_error: "❌ Ошибка сохранения ({failed}): {error}"
  untitled: "Без названия"
  type_undefined: "не определен"
  author_context_line: "Учти личность автора: {context}\n\n"
  pick_type_page_one: "Выбрать тип (страница 1):"
  preview_ready_typed: "Готово к сохранению — тип: {type}\nНазвание: {title}"
  ingest:
    tg_video_too_big: "Telegram Bot API не отдал файл видео (>20 МБ)."
    asr_needed: "ASR по ролику не выполнялся — нужен файл <20 МБ или ссылка youtu.be."
    add_youtube_link: "Для полного ролика добавь ссылку в подпись."
  review:
    type_line: "📋 Тип: {type}"
    title_line: "📝 Название: {title}"
    media_photo: "🖼️ фото"
    media_video: "🎥 видео"
    media_document: "📄 документ"
    media_file: "📎 файл"
    media_summary: "📎 Медиа: {count} файл(ов) - {kinds}"
    links_summary: "🔗 Ссылки: {count}"
    ocr_header: "📸 OCR (семпл):"
    asr_header: "🎤 ASR (семпл):"
    vision_header: "👁 Vision (сцена):"
    youtube_header: "📺 YouTube (сводка):"
    tags_line: "🏷️ Теги: {tags}"
    tags_more: "   ... и ещё {count}"
    fields_line: "📊 Поля: {fields}"
    fields_more: "   ... и ещё {count}"
    field_steps: "📋 Шаги"
    field_status: "📊 Статус"
    field_cuisine: "🍕 Кухня"

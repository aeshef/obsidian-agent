  - config/agent/prompts/knowledge_unified_tools.example.txt
  - config/agent/prompts/memory_synth.example.txt
  - config/agent/prompts/calendar_activity_router.example.txt
  - planning_bot/config/prompts/intent_router.example.txt
  - finance_bot/config/prompts/amount_extract_prompt.example.txt

# English llm_context templates (structural, no user PII) — safe in git as working examples.
generic_en_prefixes:
  - planning_bot/config/prompts/llm_context/


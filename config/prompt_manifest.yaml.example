# Prompt onboarding tiers (copy to prompt_manifest.yaml to override).
# Used by tests, ensure_bot_prompts.sh --warn-stubs, obsidian-agent-onboarding skill.
#
# generic_en   — .example.txt has working English; first copy → .txt is safe
# personalized — comment stub in git; YOU fill prod .txt during onboarding
# (any tracked *.example.txt not in generic_en → personalized)

generic_en:
  - config/agent/prompts/host_query.example.txt
  - config/agent/prompts/host_domain_router.example.txt
  - config/agent/prompts/finance_intent_router.example.txt
  - config/agent/prompts/planning_intent_router.example.txt

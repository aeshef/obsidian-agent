# UI / domain string → capability spec (shared/capabilities/ui_bindings.py).
# Optional local override: ui_capabilities.yaml (gitignored). Example is always merged.
#
# Spec: module name | connector alias | feature:name | gate:broker | gate:badge | any:a,b
#
# menu_detection: host domain menu routing (shared/telegram/host/menu_detection.py)

menu_detection:
  finance:
    reply_menu: true
    nlu_exact: true
  planning:
    planning_menu_labels: true
    exclude_host_mode_labels: true
  knowledge:
    knowledge_buttons: true

# Pinned-domain text dispatch (shared/telegram/host/domain_dispatch.py).
domain_routing:
  order:
    - finance
    - planning
    - knowledge
  menu_detection:
    finance: finance
    planning: planning
    knowledge: knowledge
  auto_menu_match:
    finance: true
    planning: true
    knowledge: true

strings:
  host.mode_finance: finance
  host.mode_planning: planning
  host.mode_knowledge: knowledge
  host.switch_finance: finance
  host.switch_planning: planning
  host.switch_knowledge: knowledge

  finance.menu.invest: any:broker,manual_broker
  finance.menu.balance: finance
  finance.menu.last_ops: finance
  finance.menu.plan: finance
  finance.menu.badge: gate:badge
  finance.sync_broker_button: gate:broker
  finance.sync_broker_progress: gate:broker
  finance.sync_broker_error: gate:broker
  finance.exact_command_broker_sync: gate:broker
  finance.inline_invest_sync: gate:broker
  finance.inline_invest_topup: any:broker,manual_broker
  finance.inline_invest_withdraw: any:broker,manual_broker
  finance.inline_invest_details: any:broker,manual_broker
  finance.invest_title: any:broker,manual_broker
  finance.invest_sync_error: gate:broker
  finance.badge_disabled: gate:badge
  finance.badge_prompt: gate:badge

  planning.menu.routines: feature:planning_routines
  planning.menu.reflection: feature:planning_weekly_review
  planning.menu.routines_stats: feature:planning_routines
  planning.menu.routines_recommendations: feature:planning_routines
  planning.menu.routines_today: feature:planning_routines
  planning.auto_checkin_close: feature:planning_daily_checkin
  planning.auto_e3bbb7b586: feature:planning_routines
  planning.submenu.kanban_column: planning
  planning.submenu.category: planning
  planning.submenu.priority: planning
  planning.messages.reflection_generating: feature:planning_weekly_review
  planning.messages.reflection_thoughts_prompt: feature:planning_weekly_review
  planning.messages.reflection_error: feature:planning_weekly_review
  planning.messages.reflection_thoughts_saved: feature:planning_weekly_review
  planning.messages.routines_recommendations_analyzing: feature:planning_routines
  planning.messages.routines_stats_error: feature:planning_routines
  planning.messages.pending_routines_header: feature:planning_routines
  planning.messages.morning_reminder: feature:planning_routines
  planning.messages.evening_reminder: feature:planning_routines

  planning.auto_f317ab8f35: feature:planning_routines
  planning.auto_b6b32200b7: feature:planning_routines
  planning.auto_7a4a4c1791: feature:planning_routines
  planning.auto_f895d3042c: feature:planning_weekly_review

  knowledge.buttons.bulk_on: knowledge
  knowledge.buttons.bulk_off: knowledge
  knowledge.buttons.query: knowledge
  knowledge.buttons.query_legacy: knowledge
  knowledge.query_prompt: knowledge
  knowledge.bulk_enabled: knowledge
  knowledge.bulk_disabled: knowledge

patterns:
  "planning.auto_*": planning
  "planning.menu.*": planning
  "finance.invest_*": "any:broker,manual_broker"
  "finance.inline_invest_*": "any:broker,manual_broker"
  "finance.sync_*broker*": "gate:broker"
  "finance.badge_*": "gate:badge"
  "planning.messages.reflection*": "feature:planning_weekly_review"
  "planning.messages.routines*": "feature:planning_routines"
  "planning.messages.pending_routines*": "feature:planning_routines"
  "planning.messages.*_reminder": "feature:planning_routines"
  "planning.messages.checkin_*": "feature:planning_daily_checkin"
  "knowledge.buttons.*": "knowledge"
  "knowledge.bulk_*": "knowledge"

# Reply-keyboard label → handler action id (Python registry per domain).
menu_actions:
  planning:
    main_keyboard:
      - auto_ca15d9d2aa
      - auto_e3bbb7b586
    reset_context:
      label_keys:
        - auto_322fab4a99
        - auto_27c8e8e900
        - auto_f0bc732b56
    reply:
      - { label_key: auto_ca15d9d2aa, action: show_tasks_menu }
      - { label_key: auto_edc1040220, action: show_categories_menu }
      - { label_key: auto_8771b735cb, action: show_priorities_menu }
      - { label_key: auto_a0b7b44b3f, action: show_statuses_menu }
      - { label_key: auto_e9917f3011, action: show_all_tasks }
      - { label_key: auto_dc232d1607, action: back_to_main }
      - { label_key: auto_f317ab8f35, action: show_routines_stats }
      - { label_key: auto_b6b32200b7, action: routines_recommendations }
      - { label_key: auto_7a4a4c1791, action: show_pending_routines }
      - { label_key: auto_f895d3042c, action: start_reflection }
      - { label_key: auto_e3bbb7b586, action: show_routines_menu }
      - { label_key: auto_checkin_close, action: start_daily_checkin }
    submenu:
      - { kind: kanban_column, action: filter_by_kanban_column }
      - { kind: category, action: filter_by_category }
      - { kind: priority, action: filter_by_priority }
  finance:
    reply:
      - { menu_key: balance, action: balance }
      - { menu_key: last_ops, action: last_ops }
      - { menu_key: badge, action: badge, requires_badge: true }
  knowledge:
    reply:
      - { button_key: bulk_on, action: bulk_on }
      - { button_key: bulk_off, action: bulk_off }
      - { button_key: query, action: query }
      - { button_key: query_legacy, action: query }

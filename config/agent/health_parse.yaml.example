# Парсинг Health/Shortcuts → снапшот IPhone/*.txt
# Скопируйте в health_parse.yaml (файл в git не коммитится).

shortcut_aliases:
  weight: weight_kg
  water: water_ml
  imt: bmi
  fat_pt: fat_pct
  bmt: lean_mass_kg
  proteins: proteins_g
  fats: fats_g
  carbs: carbs_g
  ev: calories_kcal
  pulse: pulse_bpm
  variability: hrv_ms
  recovery: recovery_score
  heartbeat: heartbeat_load
  heartbeat_still: resting_hr_bpm
  doublestand: double_support_pct
  runwalk_dist: run_walk_km
  assymetry: walking_asymmetry_pct
  asymmetry: walking_asymmetry_pct
  stability: walking_stability_pct
  movement_time: movement_min
  standing_time: standing_min
  exercising_time: exercise_min
  ups: floors_climbed
  up_speed: stairs_up_speed
  down_speed: stairs_down_speed
  walk_speed: walk_speed_kmh
  active_calories: active_calories_kcal
  resting_calories: resting_calories_kcal
  breath_freq: respiratory_rate
  oxygen: blood_oxygen_pct
  temperature: body_temp_c
  washing_hands: handwash_events
  sleep: sleep_interval

string_keys:
  - note
  - mood
  - source
  - sleep_interval
  - sleep_detail

mail_ts_formats:
  - "%d.%m.%Y, %H:%M"
  - "%Y-%m-%dT%H:%M:%S%z"
  - "%Y-%m-%dT%H:%M:%S"
  - "%Y-%m-%dT%H:%M"

file_ts_formats:
  - "%d.%m.%Y, %H:%M"
  - "%d.%m.%Y %H:%M"
  - "%Y-%m-%dT%H:%M:%S"
  - "%Y-%m-%dT%H:%M"

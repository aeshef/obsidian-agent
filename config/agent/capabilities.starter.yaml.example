# OSS starter profile — copied to capabilities.yaml by setup_agent_config.sh when missing.
# Author full install: set OBSIDIAN_AGENT_FULL_INSTALL=1 in .env and omit capabilities.yaml.
#
# First-run contract: modules only + domestic cards. All other connectors OFF
# (docs/CONNECTORS.md). Enable later via apply_capabilities_profile / --ask-connectors.

modules:
  finance: true
  planning: true
  knowledge: false

connectors:
  corporate_badge: false
  broker_sync: false
  manual_broker_accounts: false
  domestic_bank_cards: true
  apple_health: false
  gmail_health_pipeline: false
  apple_calendar: false
  mac_context: false
  knowledge_serendipity: false

sync:
  profile: planning_light

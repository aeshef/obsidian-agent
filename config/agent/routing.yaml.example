# Host routing settings. Domain/intent classification — LLM (shared/agent/llm_classify.py).
# On LLM failure the request errors out (no keyword fallback).

host:
  general_domain: planning
  # Safety net when the domain router under-selects a single domain for join questions
  # (e.g. food spend × closed tasks). Locale strings belong here, not in Python.
  cross_domain_escalation:
    finance_pattern: '(трат|потрат|расход|еда|ед[еуы]|деньг|бюджет|баланс|finance|spend|food)'
    planning_pattern: '(задач|закрыт|канбан|продуктив|completion|task|health|шаг|сон|календар)'
  # High-confidence single-domain phrases skip the LLM domain classifier.
  cheap_router:
    finance:
      - '\bбаланс\b'
      - '\bсколько\s+потрат'
      - '\bподписк'
      - '\bbalance\b'
      - '\bspending\b'
    planning:
      - '\bканбан\b'
      - '\bкалендар'
      - '\bkanban\b'
      - '\bcalendar\b'
    knowledge:
      - '\bв\s+базе\b'
      - '\bнайди\s+заметк'
      - '\bknowledge\b'

agent:
  # First agent loop iteration: tool_choice=required for these domains (when tools exist).
  tools_first_iter_domains:
    - finance
    - planning
    - knowledge
    - unified

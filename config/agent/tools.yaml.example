# domain_hints — одна строка контекста для LLM tool-select (без привязки к фразам/сценариям).

# Статичные подсказки — fallback. В runtime tool-select использует shared/capabilities/hints.py
# (только включённые модули и коннекторы).
domain_hints:
  finance: "денежные операции и сводки; dashboard chart PNGs via list_vault_charts/send_vault_charts"
  planning: "задачи, цели, календарь, опционально health/mac context; dashboard chart PNGs via list_vault_charts/send_vault_charts"
  knowledge: "именованная заметка — read_knowledge_note; обзор темы — search_knowledge_base"
  unified: "включённые домены; канбан — apply_kanban_task; интервалы from_date/to_date; dashboard chart PNGs via list_vault_charts/send_vault_charts"

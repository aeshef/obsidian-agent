# Скопируйте: cp config/agent/platform.yaml.example config/agent/platform.yaml
# Переопределение: env (см. docs/ENV_REFERENCE.md) имеет приоритет над YAML.

vault:
  # Подкаталог базы знаний внутри VAULT_PATH (rel_path в индексе).
  knowledge_subdir: Knowledge

agent:
  max_iters: 6

llm_classify:
  timeout_sec: 25
  temperature: 0.0
  dialogue_hint_per_domain: 2

knowledge_query:
  compact_catalog_max_chars: 220000
  catalog_snippet_chars: 120
  preselect_max: 40
  select_candidates_max: 40
  preselect_max_tokens: 2048
  select_max_tokens: 1024
  max_selected_notes: 14
  max_media_per_query: 6
  read_note_max_chars: 24000
  direct_read_min_score: 80
  answer_timeout_sec: 300
  preselect_timeout_sec: 120
  select_timeout_sec: 60

planning:
  # Meta-only («заведи задачку») уйдёт в chat, не в create task
  task_min_alnum_chars: 12
  task_min_words: 4

planning_action_log:
  chain_hours: 48
  chain_max_events: 0
  safety_max_events: 10000

planning_reflection:
  review_days: 7
  review_excerpt_chars: 1500
  weekly_logs_limit: 100
  previous_reflections_limit: 5

planning_llm:
  task_parsing: 0.3
  weekly_review: 0.8
  recommendations: 0.7
  goals_mapping: 0.3

tool_log:
  preview_chars: 200

knowledge_note_lookup:
  min_token_chars: 3

json_parse:
  error_preview_chars: 400

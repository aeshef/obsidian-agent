# Скопируйте: cp config/agent/platform.yaml.example config/agent/platform.yaml
# Переопределение: env (см. docs/ENV_REFERENCE.md) имеет приоритет над YAML.

vault:
  # Local Obsidian vault root. Prefer env VAULT_PATH / MOBILE_VAULT over absolute paths here.
  local_path: ""
  # iCloud mobile vault — leave empty and set MOBILE_VAULT in .env (preferred).
  mobile_path: ""
  # Подкаталог базы знаний внутри VAULT_PATH (write root + primary index root).
  # Author vault uses 700_База_Данных; OSS/onboarding may use Knowledge.
  knowledge_subdir: 700_База_Данных
  # Extra dirs to include in the note index (read/search). Keys from vault_paths.folders
  # (e.g. handwritten → 600_Рукописное). Agent writes stay on knowledge_subdir only.
  knowledge_index_extra_folders:
    - handwritten

server:
  # Remote runtime paths — prefer SERVER_BOTS / SERVER_VAULT env over committing absolutes.
  bots_root: ""
  vault_path: ""

agent:
  max_iters: 6
  tool_denied_hint_max: 12
  # Cap optional tools from LLM tool-select (always-on tools are never dropped).
  max_tools_selected: 12
  # Soft budget for tool calls executed across iterations.
  max_tool_calls: 12
  max_charts_per_send: 4
  # Mark catalog entries older than this many hours as stale (0 = disable).
  chart_stale_hours: 48
  # Truncate tool text copied into the LLM messages (full body kept for verify/join).
  tool_result_max_chars: 4000
  # Prior-turn tool facts injected into the next system prompt (0 = no cap).
  tool_facts_max_chars: 2500
  # User+assistant pairs kept in the LLM messages array (env AGENT_SESSION_MAX_TURNS wins).
  session_max_turns: 12

# Прогресс agent loop в Telegram: имена tools (без вывода tools). AGENT_PROGRESS=0 отключает.
agent_progress:
  enabled: 1
  status_message: 0
  status_max_chars: 380
  max_tools_in_status: 6
  # sendMessageDraft для статуса tools (шаг N: tool_a, …)
  draft_stream: 1
  # Потоковый финальный ответ (SSE → Telegram)
  answer_stream: 1
  # 1 = sendMessageDraft + финальный sendMessage; 0 = send_message + edit_message
  answer_draft: 1
  answer_stream_min_chars: 40
  answer_draft_interval_ms: 1000
  answer_stream_edit_ms: 900

# Incomplete answers / leaked tool-call prose (patterns in YAML, not scenario code).
answer_guard:
  promised_fetch_max_chars: 520
  tool_narration_patterns:
    - '(?i)\binvoking tool\b'
    - '(?i)\b(?:tool|function)\s+call\s*:'
    - '(?i)\bget_[a-z][a-z0-9_]*\s*\('
    - '(?i)\b[a-z][a-z0-9_]*\s*\(\s*\{'
  promised_fetch_patterns:
    - '(?i)\b(?:проверю|посмотрю|гляну|возьму|считаю|смотрю данные|собрал ленту)\b'
    - '(?i)\b(?:i(?:''ll| will) (?:check|look|fetch|compute)|let me (?:check|look))\b'

llm_classify:
  timeout_sec: 25
  temperature: 0.0
  dialogue_hint_per_domain: 2
  # Calendar activity types (batch classify on sync; no keyword fallback)
  calendar_activity_batch: 40
  calendar_activity_timeout_sec: 60

knowledge_query:
  # dense = OpenRouter embeddings (fast). catalog = LLM over one-shot note list (fallback).
  preselect_backend: dense
  embed_model: openai/text-embedding-3-large
  embed_preview_chars: 1800
  embed_batch_size: 32
  # New/changed notes embedded inline on a query; more than this → background thread.
  embed_sync_max_notes: 48
  embed_query_cache_size: 64
  embed_noise_lines:
    - субтитры
    - редактор субтитров
    - редактор_субтитров
    - без названия
    - ocr текст
    - ocr_текст
  index_extra_fields:
    - city
    - category
    - address
  # Rebuild notes_index.json when older than this (dense then reuses unchanged vectors).
  index_max_age_sec: 3600
  # Full author vault catalog ≈660k chars @ snippet=120; 800k leaves headroom.
  compact_catalog_max_chars: 800000
  catalog_snippet_chars: 120
  preselect_max: 40
  select_candidates_max: 40
  preselect_max_tokens: 2048
  select_max_tokens: 1024
  max_selected_notes: 14
  max_media_per_query: 6
  read_note_max_chars: 24000
  answer_temperature: 0.3
  answer_timeout_sec: 300
  preselect_timeout_sec: 120
  select_timeout_sec: 60

planning:
  # Meta-only («заведи задачку») уйдёт в chat, не в create task
  task_min_alnum_chars: 12
  task_min_words: 4
  # get_kanban: сколько последних задач показывать в колонке «✅ Сделано» (по created_date)
  kanban_done_preview_max: 80
  # 1 = архив закрытых задач (месячная уборка на VPS maintenance); 0 = одна доска как раньше
  kanban_archive_enabled: 1

snapshot_logs:
  # Trailing-day cap for any snapshot dir. Window = days from requested start, not span length.
  load_max_days: 400

series_tools:
  skip_as_tally_source:
    - align_day_series
    - tally_event_shares

planning_mac:
  snapshots_limit_default: 120
  snapshots_limit_max: 500
  snapshots_load_max_days: 400
  share_top_n: 8
  share_daily_top: 5

planning_calendar:
  tool_max_chars: 4000
  chat_upcoming_hours: 72
  week_summary_days_ahead: 7
  default_hours_ahead: 48
  range_max_events: 400
  sync_horizon_days: 8
  meta_stale_hours: 6
  insights_payload_max_chars: 12000
  # 1 = LLM-classify missing activity_type on calendar sync (writes into Календарь.json)
  classify_on_sync: 1

obsidian_sync:
  launchagent_interval_sec: 300

log_rotation:
  # Optional external logs not owned by the repo/runtime.
  syncthing_log: ""

planning_alerts:
  stuck_task_days: 14

telegram:
  max_message_chars: 4090
  draft_max_chars: 4096
  voice_preview_chars: 400
  min_send_interval_ms: 900
  flood_retry_max: 5
  flood_retry_after_padding_ms: 250
  flood_notify_seconds_default: 30
  # Group consecutive vault photos into Telegram albums (max 10 per album).
  media_album: 1
  media_album_max: 10
  # Bot API 10.1+ Rich Messages — agent answers as GFM (headings, tables, lists).
  # Falls back to plain text if Telegram rejects the payload.
  rich_messages: 1
  rich_max_chars: 32000

# Scheduled Telegram pushes — fewer messages, one visual language, sane times.
# All clocks/flags live here (no scenario hardcode in Python).
push_policy:
  quiet_hours:
    start: 23
    end: 7
  morning_brief:
    enabled: 1
    hour: 8
    minute: 15
    include:
      routines: 1
      stuck: 1
      deadlines: 1
      goals: 1
  # Empty = no 08/09/10 routine spam when morning_brief is on.
  routines_morning_hours: []
  # Empty when planning_checkin.replace_passive_evening_reminders is true.
  routines_evening_hours: []
  finance_txn_reminder:
    enabled: 1
    hour: 21
    minute: 0
    only_if_no_txn_today: 1
  finance_subscriptions:
    enabled: 1
    hour: 10
    minute: 0
  # Off by default — was a major feed-spam source (MWF + jitter).
  finance_daily_insight:
    enabled: 0
  finance_dashboard_insight:
    enabled: 1
  finance_daily_insight_PLACEHOLDER:
    enabled: 0
    days: mon,wed,fri
    hour: 9
    minute: 0
    jitter_sec: 7200
  finance_weekly_analysis:
    enabled: 1
    day_of_week: sun
    hour: 19
    minute: 0
  finance_monthly_analysis:
    enabled: 1
    day: 1
    hour: 9
    minute: 0
  serendipity:
    enabled: 1
    hour_start: 11
    hour_end: 20

# Reply-keyboard chrome. Free text always uses the unified agent with all tools.
host_ui:
  show_auto_mode_button: 0
  show_knowledge_query_button: 0

knowledge_ingest:
  pending_limit: 100
  media_group_cleanup_delay_sec: 60

memory_ui:
  pending_list_max: 10
  confirmed_list_max: 12
  pending_buttons_max: 8

memory_synth:
  finance_context_days: 28
  finance_recent_transactions: 15
  dialogue_excerpt_chars: 200
  dialogue_history_turns: 6

planning_action_log:
  chain_hours: 48
  chain_max_events: 0
  safety_max_events: 10000
  activity_events_limit_default: 40
  activity_events_limit_max: 1000
  task_history_months_max: 0

planning_kanban_search:
  limit_max: 100

planning_kanban_flow:
  rolling_window_days: 7
  history_max_days: 365
  aging_stale_days: 14
  lead_time_max_days: 180
  auto_backfill_min_history_days: 7
  replay_min_task_id_coverage_pct: 95
  replay_min_events_per_month: 200
  trusted_interpolate_max_gap_days: 2
  drop_partial_week_in_lead_cycle_chart: 1
  drop_today_in_column_charts: 0

planning_reflection:
  review_days: 7
  review_excerpt_chars: 1500
  weekly_logs_limit: 100
  previous_reflections_limit: 5

planning_checkin:
  hour: 23
  minute: 45
  snooze_minutes: 30
  replace_passive_evening_reminders: true
  ritual_day_end_hour: 4

planning_llm:
  task_parsing: 0.3
  weekly_review: 0.8
  recommendations: 0.7
  routines_recommendations: 0.7
  goals_mapping: 0.3
  calendar_insights: 0.45
  chat_timeout_sec: 90

asr:
  http_timeout_sec: 600

knowledge_extract:
  text_intent_timeout_sec: 45
  vision_gate_timeout_sec: 35
  vision_api_timeout_sec: 90
  ffmpeg_frame_timeout_sec: 15
  ffprobe_timeout_sec: 5
  web_fetch_timeout_sec: 15
  serendipity_timeout_sec: 90
  vision_openrouter_temperature: 0.2

llm_reachable:
  timeout_sec: 4

json_parse:
  error_preview_chars: 400

agent_trace:
  # 1 = append jsonl cost/latency traces (no tool bodies)
  enabled: 1
  path: logs/agent_traces.jsonl
  # USD per 1M tokens — used by cost dashboard / rollup (override for your model).
  pricing:
    default_model: deepseek-v4-flash
    prompt_per_m: 0.14
    completion_per_m: 0.28
    models:
      deepseek-v4-flash:
        prompt_per_m: 0.14
        completion_per_m: 0.28
      deepseek-chat:
        prompt_per_m: 0.27
        completion_per_m: 1.10

# On-demand chart rebuild allowlist (relative to AGENT_ROOT). Disabled by default.
chart_refresh:
  enabled: 0
  timeout_sec: 180
  max_builders_per_call: 1
  builders:
    finance:
      script: finance_bot/scripts/build_finance_dashboard.py
      args: ["--vault", "{vault}"]
    planning_activity:
      script: planning_bot/scripts/build_daily_task_activity_chart.py
      args: ["--vault", "{vault}"]
    planning_completions:
      script: planning_bot/scripts/build_daily_completions_by_category_chart.py
      args: ["--vault", "{vault}"]
    kanban_flow:
      script: planning_bot/scripts/build_kanban_flow_dashboard.py
      args: ["--vault", "{vault}"]
    agent_cost:
      script: scripts/build_agent_cost_dashboard.py
      args: ["--vault", "{vault}", "--days", "30"]

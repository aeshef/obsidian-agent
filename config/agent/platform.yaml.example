# Скопируйте: cp config/agent/platform.yaml.example config/agent/platform.yaml
# Переопределение: env (см. docs/ENV_REFERENCE.md) имеет приоритет над YAML.

vault:
  # Подкаталог базы знаний внутри VAULT_PATH (rel_path в индексе).
  knowledge_subdir: Knowledge

agent:
  max_iters: 6
  tool_denied_hint_max: 12

# Прогресс agent loop в Telegram: имена tools (без вывода tools). AGENT_PROGRESS=0 отключает.
agent_progress:
  enabled: 1
  status_message: 1
  status_max_chars: 380
  max_tools_in_status: 6
  # sendMessageDraft для статуса tools (шаг N: tool_a, …)
  draft_stream: 0
  # Потоковый финальный ответ (SSE → Telegram)
  answer_stream: 1
  # 1 = sendMessageDraft + финальный sendMessage; 0 = send_message + edit_message
  answer_draft: 1
  answer_stream_min_chars: 40
  answer_draft_interval_ms: 80
  answer_stream_edit_ms: 900

llm_classify:
  timeout_sec: 25
  temperature: 0.0
  dialogue_hint_per_domain: 2

knowledge_query:
  compact_catalog_max_chars: 220000
  catalog_snippet_chars: 120
  preselect_max: 40
  select_candidates_max: 40
  preselect_max_tokens: 2048
  select_max_tokens: 1024
  max_selected_notes: 14
  max_media_per_query: 6
  read_note_max_chars: 24000
  answer_temperature: 0.3
  answer_timeout_sec: 300
  preselect_timeout_sec: 120
  select_timeout_sec: 60

planning:
  # Meta-only («заведи задачку») уйдёт в chat, не в create task
  task_min_alnum_chars: 12
  task_min_words: 4
  # get_kanban: сколько последних задач показывать в колонке «✅ Сделано» (по created_date)
  kanban_done_preview_max: 80
  # 1 = архив закрытых задач (месячная уборка на VPS maintenance); 0 = одна доска как раньше
  kanban_archive_enabled: 1

planning_mac:
  snapshots_limit_default: 120
  snapshots_limit_max: 500

planning_calendar:
  tool_max_chars: 4000
  chat_upcoming_hours: 72
  week_summary_days_ahead: 7
  default_hours_ahead: 48
  range_max_events: 400
  sync_horizon_days: 8
  meta_stale_hours: 6
  insights_payload_max_chars: 12000

obsidian_sync:
  launchagent_interval_sec: 300

planning_alerts:
  stuck_task_days: 14

telegram:
  max_message_chars: 4090
  voice_preview_chars: 400

knowledge_ingest:
  pending_limit: 100
  media_group_cleanup_delay_sec: 60

memory_ui:
  pending_list_max: 10
  confirmed_list_max: 12
  pending_buttons_max: 8

memory_synth:
  finance_context_days: 28
  finance_recent_transactions: 15
  dialogue_excerpt_chars: 200
  dialogue_history_turns: 6

planning_action_log:
  chain_hours: 48
  chain_max_events: 0
  safety_max_events: 10000
  activity_events_limit_default: 40
  activity_events_limit_max: 1000
  task_history_months_max: 0

planning_kanban_search:
  limit_max: 100

planning_reflection:
  review_days: 7
  review_excerpt_chars: 1500
  weekly_logs_limit: 100
  previous_reflections_limit: 5

planning_checkin:
  hour: 23
  minute: 45
  snooze_minutes: 30
  replace_passive_evening_reminders: true
  ritual_day_end_hour: 4

planning_llm:
  task_parsing: 0.3
  weekly_review: 0.8
  recommendations: 0.7
  routines_recommendations: 0.7
  goals_mapping: 0.3
  calendar_insights: 0.45
  chat_timeout_sec: 90

asr:
  http_timeout_sec: 600

knowledge_extract:
  text_intent_timeout_sec: 45
  vision_gate_timeout_sec: 35
  vision_api_timeout_sec: 90
  ffmpeg_frame_timeout_sec: 15
  ffprobe_timeout_sec: 5
  web_fetch_timeout_sec: 15
  serendipity_timeout_sec: 90
  vision_openrouter_temperature: 0.2

llm_reachable:
  timeout_sec: 4

json_parse:
  error_preview_chars: 400

# Многослойная память (shared/memory). Пути относительно config/agent/, если не абсолютные.
global_profile: user_profile.md

headers:
  global_profile: "## Общий профиль"
  domain_profile:
    finance: "## Профиль (финансы)"
    planning: "## Контекст целей"

insights:
  global_limit: 8
  domain_limit: 10
  periodic_ttl_days: 45
  profile_excerpt_max: 400

# Compact priors injected on unified every turn (confirmed only).
core:
  max_lines: 8

# Short-lived follow-up entities (shared/memory/working_set.py).
working_set:
  max_items: 12
  format_notes: 4
  format_entities: 6

# Live HUD: calendar today + kanban in-work. Cached; fail open.
situation:
  cache_sec: 60
  max_chars: 1200
  calendar_max_lines: 8
  wip_max_tasks: 8

# Agent-proposed appends to user_profile.md (confirm required; never auto-write).
profile_append:
  section_header: "## Agent notes"
  max_chars: 500
  pending_ttl_hours: 48


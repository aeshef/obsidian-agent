# Product capabilities — copy to capabilities.yaml (gitignored).
# Missing capabilities.yaml:
#   - OBSIDIAN_AGENT_FULL_INSTALL=1 in .env → full install (maintainer)
#   - otherwise → capabilities.starter.yaml.example (OSS default)
#
# Prefer starting from capabilities.starter.yaml.example, then enable only
# connectors you use (docs/CAPABILITIES.md). Omitted keys are fail-closed OFF.

modules:
  finance: true
  planning: true
  knowledge: false

connectors:
  # Workplace meal benefit (needs finance_bot/config/badge.yaml)
  corporate_badge: false
  # Broker portfolio API (finance_bot/config/broker_sync.yaml + token in .env)
  broker_sync: false
  # Manual broker/custodian accounts in finance YAML (no API)
  manual_broker_accounts: false
  # Card/wallet balances in finance dashboard
  domestic_bank_cards: true
  # Apple Health via Shortcuts / IPhone export
  apple_health: true
  # Gmail IMAP health pipeline (GMAIL_IMAP_* in .env)
  gmail_health_pipeline: false
  # Apple Calendar export → vault
  apple_calendar: true
  # Mac focus / context snapshots
  mac_context: true
  # Daily random KB note in Telegram (needs knowledge: true)
  knowledge_serendipity: false

sync:
  # full | finance_only | planning_light | planning_kanban | knowledge_only | minimal
  profile: planning_light

  cli_namespaces: "Namespaces: {count}"

knowledge_maintenance:
  chart_suptitle: "Обслуживание 700_База_Данных (ежедневные снимки)"
  chart_notes_before: "до"
  chart_notes_after: "после"
  chart_notes_title: "Заметок .md в 700_"
  chart_export_title: "Export, МБ (снимок «до»)"
  chart_queue_title: "Очередь reprocess (eligible, до прогона)"
  chart_bar_reprocess: "reprocess записано"
  chart_bar_empty: "reprocess удал.pуст."
  chart_bar_dup: "дубли МБ"
  chart_daily_title: "Итоги за день (шаги, сумма если было несколько прогонов)"
  report_section: "## 4. Динамика обслуживания"
  report_intro: |
    История снимков и итогов шагов (`vault_daily_maintenance`): данные в `{history_path}`.

    **Несколько прогонов за день:** снимок «до» — с первого прогона, «после» — с последнего;

    столбцы retag / reprocess / дубли — **сумма** за день; `singleton` в `run` — с последнего прогона.

  report_chart_pending: "*График появится после ≥1 записи в истории и при установленном `matplotlib` в окружении, где генерируется отчёт.*"
  report_no_history: "*Пока нет записей истории — прогоните обслуживание хотя бы раз.*"
  report_table_days: "Последние **{days}** дней (новые снизу):"
  report_table_header: "| Дата | № | Δ .md | −дуб | −repr∅ | retag | repr✓ | Export−MB | OK |"
  report_last_deletions_header: "**Удалённые пути (последний прогон, {ts}):**"
  report_last_deletions_more: "… и ещё {count} (см. `.sync/last_maintenance_deleted_paths.json`)"
  regex_retag_total: 'Итого:\s*затронуто=(\d+),\s*пропущено=(\d+)(?:,\s*llm_fallback=(\d+))?'
  regex_changed: 'Изменено:\s*(\d+)'
  marker_saved: "✓ Записано:"
  marker_deleted_empty: "[удалено: нет контента]"
  regex_deleted_line: '^\s*удалён:'
  dup_delete_marker: 'удалить:'
  regex_dup_freed: 'Файлов:\s*(\d+),\s*освобождено\s*~([0-9.]+)\s*МБ'
  regex_refill_total: 'Итого refill: затронуто=(\d+), пропущено=(\d+), llm_errors=(\d+)'
  regex_singleton_count: 'Заметок, из которых будут/были удалены singleton-теги:\s*(\d+)'
  regex_export_orphans_summary: 'EXPORT_ORPHANS_SUMMARY:\s*total=(\d+)\s+bytes=(\d+)\s+referenced=(\d+)\s+export_total=(\d+)'
  regex_export_broken_refs: 'EXPORT_BROKEN_REFS:\s*count=(\d+)'
  regex_export_rehydrated_total: 'EXPORT_REHYDRATED_TOTAL:\s*count=(\d+)'
  regex_export_deleted_total: 'EXPORT_ORPHANS_DELETED_TOTAL:\s*count=(\d+)\s+bytes=(\d+)'
  regex_export_broken_refs_cleaned: EXPORT_BROKEN_REFS_CLEANED_NOTES:\s*count=(\d+)
  regex_export_broken_body_refs_cleaned: EXPORT_BROKEN_BODY_REFS_CLEANED_NOTES:\s*count=(\d+)


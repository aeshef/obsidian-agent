  log_entry_regex: "## (\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})\\n\\n\\*\\*Тип:\\*\\* (.+?)\\n\\n\\*\\*Данные:\\*\\*\\n```json\\n(.+?)\\n```"

# Vault Obsidian dashboards — block catalog (locale + module aware).
# cp via materialize_locale.py; rendered by scripts/scaffold_vault_dashboards.py

strings:
  nav_callout: |
    > [!abstract] Дашборды
    > [[🎯 Главный_Дашборд|🎯 Главный]] · [[📊 Прогресс_2026|📊 Прогресс & поток]] · [[🏥 Здоровье|🏥 Здоровье]] · [[🔬 Аналитика|🔬 Жизнь]] · [[🛠 Система|🛠 Система]] · [[📅 Встречи_и_фокус_недели|📅 Встречи]] · [[📊 Финансы_Дашборд|💰 Финансы]]
  preamble_tip: |
    > [!tip] Кокпит дня
    > Фокус квартала и сигналы. Канбан-графики — в [[📊 Прогресс_2026|Прогрессе]].
  section_goals: "## 🎯 Цели"
  section_progress: "## 🔗 Цели и категории"
  chart_activity_title: "### Дневная активность задач (по типам и приоритетам)"
  chart_activity_body: |
    Линейный график по дням, начиная с момента, когда в action-логах появился `task_id`.
  chart_completions_title: "### Завершено по категориям (по дням)"
  chart_completions_body: "Линейный график: сколько задач завершено в каждый день по категориям."
  chart_pipeline_title: "### Нагрузка: открытый пайплайн по категориям"
  chart_pipeline_body: |
    Столбчатый график: незавершённые задачи вне «{{done_column}}», снимок на день.
  chart_kanban_flow_title: "### Поток канбана (метрики + маппинг целей)"
  chart_kanban_flow_body: |
    CFD, lead/cycle time, aging WIP, завершения по сегментам (к целям / быт / без цели). Хаб: [[{{charts_subdir}}/{{chart_kanban_flow_hub_md}}|метрики потока]].
  chart_kanban_flow_arrivals_title: "### Поток: прибытия / завершения"
  chart_kanban_flow_arrivals_body: "Динамика arrivals, departures и flow debt."
  chart_kanban_flow_cfd_title: "### Поток: CFD по колонкам"
  chart_kanban_flow_cfd_body: "Кумулятивный поток задач по колонкам."
  chart_kanban_flow_lead_cycle_title: "### Поток: lead/cycle time"
  chart_kanban_flow_lead_cycle_body: "Недельный p50 lead/cycle (без неполной текущей недели)."
  chart_kanban_flow_aging_title: "### Поток: aging WIP"
  chart_kanban_flow_aging_body: "Распределение возраста открытых задач."
  chart_kanban_flow_transitions_title: "### Поток: переходы между колонками"
  chart_kanban_flow_transitions_body: "Heatmap переходов `from → to`."
  chart_kanban_flow_goal_mapping_title: "### Поток: завершения по сегментам целей"
  chart_kanban_flow_goal_mapping_body: "Сегменты: к целям / быт / без цели."
  chart_kanban_flow_wip_segments_title: "### Поток: WIP по сегментам"
  chart_kanban_flow_wip_segments_body: "Открытый WIP по сегментам целей."
  chart_deadlines_title: "### Дедлайны по календарю (горизонт)"
  chart_deadlines_body: |
    Stacked bar по дням: задачи с `#{{tag_deadline}}/YYYY-MM-DD`. Подробности в [[{{charts_subdir}}/{{chart_deadline_md}}|заметке графика]].
  chart_nutrition_title: "### Питание: КБЖУ (ккал на день)"
  chart_nutrition_body: "Данные — снимок из iPhone-контекста. Подробно: [[{{nutrition_dashboard}}]]."
  finance_embed_title: "## 💰 Финансы"
  finance_embed_body: "Автообновление: [[{{finance_dashboard}}|Финансы]]. Сборка: `finance_bot/scripts/run_finance_dashboard.sh`."
  section_analytics: "## 🔬 Аналитика"
  analytics_embed_title: "### Аналитика"
  analytics_embed_body: "Таблицы гипотез и покрытие данных. Графики — на [[{{analytics_dashboard}}|странице аналитики]]."
  footer: "_Обновляй раз в неделю, чтобы видеть общую картину._"
  goals_not_found: "⚠️ Файл целей не найден"
  no_focus_tasks: "📭 Нет активных целей с тегом"
  add_focus_hint: "👉 Добавь #{{tag_focus}}/"
  open_goals: "👉 [[{{goals_page}}|Открыть цели]]"
  quarter_focus_heading: "### Текущий квартальный фокус"
  quarter_progress_heading: "### Прогресс по квартальным фокусам"
  no_quarter_focus: "Квартальные фокусы не заполнены"
  kanban_not_found: "⚠️ Канбан-доска не найдена"
  mapping_not_found: "⚠️ Файл маппинга не найден или пуст"
  mapping_error: "⚠️ Ошибка при чтении маппинга"
  no_mapped_tasks: "📭 Нет задач, связанных с целями."
  goals_mapping_heading: "### Прогресс по целям (маппинг задач)"
  category_progress_heading: "### Прогресс по категориям"
  category_progress_year_heading: "## 📈 Прогресс по категориям за год"
  goals_priorities_heading: "## 📊 Цели и их приоритеты"
  no_goals_priorities: "Нет целей с приоритетами"
  progress_year_footer: "_Этот файл показывает общую картину за год. Для деталей используй [[{{main_dashboard}}|Главный дашборд]]._"
  no_categorized_tasks: "Нет задач с категориями"
  label_no_category: "без категории"
  label_no_priority: "без приоритета"
  table_quarter: "Квартал"
  table_goals: "Целей"
  table_progress: "Прогресс"
  table_goal: "Цель"
  table_tasks: "Задачи"
  table_category: "Категория"
  table_open: "Открыто"
  table_done: "Закрыто"
  table_done_30d: "Закрыто 30д"
  table_done_all: "Закрыто всего"
  table_wip_bar: "WIP"
  table_priority: "Приоритет"
  quarter_names:
    Q1: "Q1 {year} (Январь - Март)"
    Q2: "Q2 {year} (Апрель - Июнь)"
    Q3: "Q3 {year} (Июль - Сентябрь)"
    Q4: "Q4 {year} (Октябрь - Декабрь)"

dashboards:
  main:
    file_key: main_dashboard_md
    blocks:
      - nav_callout
      - preamble
      - section_goals
      - goals_quarter_focus
      - goals_quarter_progress
      - cockpit_signals
      - section_progress
      - goals_mapping
      - category_progress
      - cockpit_links
  progress_year:
    file_key: progress_year_dashboard_md
    blocks:
      - nav_callout
      - category_progress_year
      - chart_daily_activity
      - chart_completions
      - chart_open_pipeline
      - chart_deadlines
      - chart_kanban_flow_arrivals
      - chart_kanban_flow_cfd
      - chart_kanban_flow_lead_cycle
      - chart_kanban_flow_aging
      - chart_kanban_flow_transitions
      - chart_kanban_flow_goal_mapping
      - chart_kanban_flow_wip_segments
      - goals_quarter_progress
      - goals_priorities
      - progress_year_footer


# cp config/messages.en.yaml.example → config/messages.en.yaml
# English Telegram UI catalog. Keys must match messages.ru.yaml.example.
# Russian UI: messages.ru.yaml.example; your prod copy: messages.ru.yaml (gitignored).

agent:

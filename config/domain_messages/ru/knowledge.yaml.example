knowledge_maintenance:
  chart_suptitle: Обслуживание 700_База_Данных (ежедневные снимки)
  chart_notes_before: до
  chart_notes_after: после
  chart_notes_title: Заметок .md в 700_
  chart_export_title: Export, МБ (снимок «до»)

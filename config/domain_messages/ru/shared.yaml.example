note_lookup:
  empty_query: пустой запрос или индекс
  no_exact_match: нет точного совпадения в индексе
memory_tools:
  unknown_domain: 'Неизвестный домен: {dom}. Допустимо: {allowed}.'
  empty_history: (история диалога [{dom}] пуста)
  history_header: 'Последние реплики [{dom}] (до {count} сообщений):'
  history_from_domain: ' (запрошено из домена {domain})'
  capture_empty: Текст наблюдения пуст.
  capture_pending: 'Кандидат id={id} [{domain}] (подтверждений={count}): {text}'
  capture_ready: 'Сохранено наблюдение id={id} [{domain}]: {text}'
  pending_empty: Нет ожидающих наблюдений.
  pending_header: 'Ожидают подтверждения ({count}):'
  pending_item: '  id={id} [{domain}/{kind}] x{count}: {text}'
  bad_pending_id: Некорректный pending_id.
  confirm_ok: Подтверждено наблюдение id={id}.
  confirm_fail: Не удалось подтвердить id={id}.
  reject_ok: Отклонено наблюдение id={id}.
  reject_fail: Не удалось отклонить id={id}.
  working_set_empty: (working set пуст)
  working_set_pin_empty: Нечего закрепить (пустое value).
  working_set_pin_ok: Закреплено [{kind}] {value}.
  working_set_cleared: Working set очищен (kind={kind}, value={value}).
  profile_append_empty: Текст для профиля пуст.
  profile_append_pending: 'Черновик профиля id={id}: {text} — подтверди confirm_profile_append.'
  profile_append_ok: Добавлено в {path} (id={id}).
  profile_append_fail: Не удалось подтвердить/отклонить id={id}.
  profile_append_rejected: Отклонено id={id}.
  profile_append_bad_id: Некорректный pending_id профиля.
memory_layers:
  profile_unset: (профиль не задан)
  global_prefix: 'Глобальные:'
  no_confirmed: (подтверждённых наблюдений нет)
  global_observations: 'Глобальные наблюдения:'
  no_global: (глобальных наблюдений нет)
  unknown_scope: 'Неизвестный scope/domain: {scope}. Допустимо: current, global, all, finance, planning, knowledge.'
  observations: 'Наблюдения [{dom}]:'
  no_domain_confirmed: (подтверждённых наблюдений для {dom} нет)
  pending_line: '  • [{domain}, {date}, {kind}] {text} (кандидат, ×{count})'
  pending_header: 'Кандидаты (ещё не в промпте; подтверди в меню «Память»):'
  durable_header: 'Устойчивые наблюдения:'
  periodic_header: 'Периодические наблюдения (с TTL):'
  core_header: '## Приоры (подтверждённые)'
  core_line: '- [{domain}/{kind}] {text}'
  situation_header: '## Сейчас'
  situation_calendar: 'Календарь сегодня:'
  situation_wip: 'В работе:'
  situation_wip_none: 'В работе: пусто'
memory_insights:
  global_header: '## Общие наблюдения о пользователе'
  domain_header: '## Наблюдения ({domain})'
  prompt_line: '- [{date}] {text}'
  confirmed_ui_line: • [{domain}, {date}, {kind}] {text}
  pending_ui_line: '• [{domain}, {date}, {kind}] #{id}: {text} (×{count})'
log_dump:
  coverage: 'запрошено {start}…{end}. полное совпадение: n={n} first={match_first} last={match_last}. показано: {shown} first={shown_first}
    last={shown_last}. Агрегаты ниже по ВСЕМ {n}, не по показанному срезу.'
  incomplete_start: 'НЕПОЛНО: first={first} позже запрошенного start={requested_start}. Более ранние метки не считай отсутствующими
    в источнике.'
  incomplete_end: 'НЕПОЛНО: shown last={last}; полное совпадение идёт до {requested_end}. Более поздние метки не считай отсутствующими
    в источнике.'
  slice_note: 'Сырой срез — {kind}: {shown}/{total} строк. Агрегаты выше уже по полному совпадению.'
  shares_header: 'Доли «{column}» (все {n} точек, mode={mode}):'
  other: другое
asr:
  not_installed: 'ASR недоступен: установите faster-whisper: pip install faster-whisper'
  recognition_failed: Не удалось распознать речь. Запишите сообщение ещё раз, чуть дольше и чётче.

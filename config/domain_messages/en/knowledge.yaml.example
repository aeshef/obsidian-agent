knowledge_tags_prompt:
  broker_fee: Broker commission
  broker_topup: Broker deposit
  broker_withdraw: Broker withdrawal
  debt_issue_description: Debt to {counterparty}
  debt_return_description: Debt repayment from {counterparty}
  debts_category: Debts
  default_counterparty: Counterparty
  json_append: 'Response — **valid JSON only** (no markdown or explanations), object with `tags` key — array of strings:


    {"tags": ["domain/...", "topic/..."]}



    Use only tags from inventory and controlled namespaces; do not invent new topic/* with count=1.


    tags_starter: |


    # tags.txt — full tag ontology (not committed to git).


    # Copy your prompt here: domain/topic rules, few-shot, inventory.


    # Minimum for JSON-mode API — block below (word json required).



    You are an Obsidian note tagging assistant. Given JSON input, suggest tags.



    finance:'
  misc: Other
  transfer_substring: translation
  uncategorized: Uncategorized

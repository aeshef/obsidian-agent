  dup_cap_exceeded: '⛔ apply_duplicates: {count} files to delete > limit {max_delete}.


    Auto-apply cancelled — run manually:


    singleton_regex: ''Tags with 1 note:\s*(\d+)''


    singleton_suggestion: |


    🏷 <b>Singleton tags</b>: found {count} tags used in only 1 note.


    To remove noise from the graph, run:


    refill_ok_line: ''^Total refill:|llm_errors\s*=\s*0''

    '
  dup_delete_marker: 'delete:'
  llm_offline: 'api.deepseek.com unreachable (DNS/network) — wikilinks/retag/reprocess skipped.



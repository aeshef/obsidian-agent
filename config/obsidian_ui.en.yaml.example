  "layout": {
    "view_root": "Assistant UI",
    "recent_limit": 24,
    "library_file": "Library.md",
    "status_max_age_seconds": 3600
  },
  "interactive": {
    "default_days": 30,
    "table_page_size": 100,
    "max_range_days": 3660,
    "metrics": [
      "steps",
      "calories_kcal",
      "weight_kg",
      "resting_hr_bpm",
      "hrv_ms",
      "iphone_sleep_hours",
      "active_calories_kcal",
      "exercise_min",
      "wrist_temp_c",
      "kcal_macros",
      "fat_pct"
    ],
    "cross_metrics": [
      "tasks_completed",
      "expense_rub",
      "income_rub",
      "steps",
      "kcal"
    ],
    "max_series": 7,
    "export_cache_hours": 24,
    "export_width": 1400,
    "export_height": 650,
    "deadline_horizon_days": 7,
    "health_groups": [
      {
        "id": "nutrition_macros",
        "metrics": [
          "proteins_g",
          "fats_g",
          "carbs_g"
        ]
      },
      {
        "id": "sleep_stages",
        "metrics": [
          "iphone_sleep_deep_min",
          "iphone_sleep_rem_min",
          "iphone_sleep_core_min",
          "iphone_sleep_awake_min"
        ]
      }
    ],
    "panel_metrics": [
      "iphone_weight_kg",
      "iphone_weight_delta_next",
      "iphone_sleep_hours",
      "iphone_sleep_hours_lag1",
      "iphone_sleep_deep_min",
      "iphone_sleep_rem_min",
      "iphone_sleep_core_min",
      "iphone_sleep_awake_min",
      "iphone_steps",
      "iphone_hrv_ms",
      "iphone_resting_hr_bpm",
      "kcal",
      "tasks_completed",
      "expense_rub",
      "income_rub"
    ],
    "panel_charts": [
      {
        "id": "panel_weight",
        "metrics": [
          "iphone_weight_kg"
        ]
      },
      {
        "id": "panel_sleep",
        "metrics": [
          "iphone_sleep_hours"
        ]
      },
      {
        "id": "panel_stages",
        "metrics": [
          "iphone_sleep_deep_min",
          "iphone_sleep_rem_min",
          "iphone_sleep_core_min",
          "iphone_sleep_awake_min"
        ],
        "type": "bar"
      },
      {
        "id": "panel_activity",
        "metrics": [
          "tasks_completed"
        ],
        "method": "sum",
        "type": "bar"
      },
      {
        "id": "panel_spending",
        "metrics": [
          "expense_rub",
          "income_rub"
        ],
        "method": "sum"
      }
    ],
    "min_correlation_pairs": 8
  },
  "freshness": {
    "max_age_seconds": 7200,
    "daily_seconds": 93600
  },
  "overview": {
    "agenda_limit": 16,
    "window_limit": 4,

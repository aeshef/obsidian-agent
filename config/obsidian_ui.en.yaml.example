  "chart": {
    "max_ticks": 8,
    "figure_width": 11,
    "font_size": 11,
    "weekly_after_days": 62,
    "palette": [
      "#ad5b91",
      "#557e9c",
      "#648676",
      "#b08652",
      "#81769d",
      "#759fa0",
      "#a87878",
      "#7c8595"

# Vault Obsidian dashboards — block catalog (locale + module aware).

strings:
  nav_callout: |
    > [!abstract] Dashboards
    > [[🎯 Главный_Дашборд|🎯 Main]] · [[📊 Прогресс_2026|📊 Progress & flow]] · [[🏥 Здоровье|🏥 Health]] · [[🔬 Аналитика|🔬 Analytics]] · [[📅 Встречи_и_фокус_недели|📅 Meetings]] · [[📊 Финансы_Дашборд|💰 Finance]]
  preamble_tip: |
    > [!tip] Week in meetings
    > Auto-updated: [[{{calendar_dashboard}}|Meetings and week focus]] · data [[{{data_subdir}}/{{calendar_json}}|{{calendar_json}}]].
  section_goals: "## 🎯 Goals"
  section_progress: "## 📈 Progress"
  chart_activity_title: "### Daily task activity (by type and priority)"
  chart_activity_body: |
    Line chart by day since stable `task_id` chains appear in action logs.
  chart_completions_title: "### Completed by category (daily)"
  chart_completions_body: "Line chart: tasks completed per day by category."
  chart_pipeline_title: "### Load: open pipeline by category"
  chart_pipeline_body: |
    Bar chart: open tasks outside «{{done_column}}», one snapshot per day.
  chart_kanban_flow_title: "### Kanban flow (metrics + goals mapping)"
  chart_kanban_flow_body: |
    CFD, lead/cycle time, aging WIP, completions by segment (goal-linked / daily / unmapped). Hub: [[{{dashboards_folder}}/{{charts_subdir}}/{{chart_kanban_flow_hub_md}}|flow metrics]].
  chart_kanban_flow_arrivals_title: "### Flow: arrivals / departures"
  chart_kanban_flow_arrivals_body: "Daily arrivals, departures, and flow debt."
  chart_kanban_flow_cfd_title: "### Flow: CFD by columns"
  chart_kanban_flow_cfd_body: "Cumulative flow by kanban column."
  chart_kanban_flow_lead_cycle_title: "### Flow: lead/cycle time"
  chart_kanban_flow_lead_cycle_body: "Weekly p50 lead/cycle (partial current week excluded)."
  chart_kanban_flow_aging_title: "### Flow: aging WIP"
  chart_kanban_flow_aging_body: "Age distribution of open tasks."
  chart_kanban_flow_transitions_title: "### Flow: column transitions"
  chart_kanban_flow_transitions_body: "Heatmap of `from → to` transitions."
  chart_kanban_flow_goal_mapping_title: "### Flow: completions by goal segment"
  chart_kanban_flow_goal_mapping_body: "Segments: goal-linked / daily / unmapped."
  chart_kanban_flow_wip_segments_title: "### Flow: WIP by goal segment"
  chart_kanban_flow_wip_segments_body: "Open WIP split by goal segments."
  chart_deadlines_title: "### Deadlines horizon"
  chart_deadlines_body: |
    Stacked bar by due date (`#{{tag_deadline}}/YYYY-MM-DD`). Details: [[{{dashboards_folder}}/{{charts_subdir}}/{{chart_deadline_md}}|chart note]].
  chart_nutrition_title: "### Nutrition: macros (kcal per day)"
  chart_nutrition_body: "iPhone context snapshot. Details: [[{{nutrition_dashboard}}]]."
  finance_embed_title: "## 💰 Finance"
  finance_embed_body: "Auto-updated: [[{{finance_dashboard}}|Finance dashboard]]. Build: `finance_bot/scripts/run_finance_dashboard.sh`."
  section_analytics: "## 🔬 Analytics"
  analytics_embed_title: "### Analytics"
  analytics_embed_body: "Hypothesis tables and data coverage. Charts live on [[{{analytics_dashboard}}|Analytics hub]]."
  footer: "_Refresh weekly for the big picture._"
  goals_not_found: "⚠️ Goals file not found"
  no_focus_tasks: "📭 No active goals with tag"
  add_focus_hint: "👉 Add #{{tag_focus}}/"
  open_goals: "👉 [[{{goals_page}}|Open goals]]"
  quarter_focus_heading: "### Current quarterly focus"
  quarter_progress_heading: "### Quarterly focus progress"
  no_quarter_focus: "Quarterly focus tags not set"
  kanban_not_found: "⚠️ Kanban board not found"
  mapping_not_found: "⚠️ Mapping file missing or empty"
  mapping_error: "⚠️ Error reading mapping"
  no_mapped_tasks: "📭 No tasks linked to goals."
  goals_mapping_heading: "### Goal progress (task mapping)"
  goals_mapping_legend: "Progress — share of closed mapped tasks (step coverage, not goal success). Sorted by open."
  category_progress_heading: "### Progress by category"
  category_progress_year_heading: "## 📈 Progress by category (year)"
  goals_priorities_heading: "## 📊 Goals by priority"
  no_goals_priorities: "No goals with priority tags"
  progress_year_footer: "_Year overview. Details: [[{{main_dashboard}}|Main dashboard]]._"
  no_categorized_tasks: "No tasks with categories"
  label_no_category: "uncategorized"
  label_no_priority: "no priority"
  table_quarter: "Quarter"
  table_goals: "Goals"
  table_progress: "Progress"
  table_goal: "Goal"
  table_tasks: "Tasks"
  table_category: "Category"
  table_open: "Open"
  table_done: "Done"
  table_done_30d: "Done 30d"
  table_done_all: "Done all"
  table_wip_bar: "WIP share"
  table_priority: "Priority"
  label_wip_total_open: "Open total"
  label_wip_total_done30: "Done in 30d"
  label_wip_categories: "Categories"
  category_wip_legend: "WIP share — open tasks in this category as % of all open WIP (portfolio mix). Sorted by open. Red open count — high stock with weak 30d throughput."
  cockpit_signals_empty: "No Life OS data yet — appears after analytics sync."
  cockpit_signals_links: "→ [[{{analytics_dashboard}}|Analytics]] · [[{{finance_dashboard}}|Finance / daily limit]]"
  cockpit_label_sleep_debt: "Sleep debt"
  analytics_regime_flow: "Flow — capacity↑ + output↑"
  analytics_regime_charge: "Charge — capacity↑, output↓"
  analytics_regime_overreach: "Overreach — output with capacity↓"
  analytics_regime_recovery: "Recovery — both↓"
  quarter_names:
    Q1: "Q1 {year} (January - March)"
    Q2: "Q2 {year} (April - June)"
    Q3: "Q3 {year} (July - September)"
    Q4: "Q4 {year} (October - December)"

dashboards:
  main:
    file_key: main_dashboard_md
    blocks:
      - nav_callout
      - preamble
      - calendar_tip
      - section_goals
      - goals_quarter_focus
      - goals_quarter_progress
      - section_progress
      - chart_daily_activity
      - chart_completions
      - chart_open_pipeline
      - chart_deadlines
      - chart_nutrition
      - analytics_embed
      - goals_mapping
      - category_progress
      - finance_embed
      - footer

  progress_year:
    file_key: progress_year_dashboard_md
    blocks:
      - nav_callout
      - category_progress_year
      - chart_kanban_flow_arrivals
      - chart_kanban_flow_cfd
      - chart_kanban_flow_lead_cycle
      - chart_kanban_flow_aging
      - chart_kanban_flow_transitions
      - chart_kanban_flow_goal_mapping
      - chart_kanban_flow_wip_segments
      - goals_quarter_progress
      - goals_priorities
      - progress_year_footer


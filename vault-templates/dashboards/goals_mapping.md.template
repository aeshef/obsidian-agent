const TAG_GOAL = "{{tag_goal}}";
const mappingFilePath = "{{mapping_path}}"
const kanbanPages = ["{{kanban_page}}"]
  .concat("{{kanban_archive_page}}" ? ["{{kanban_archive_page}}"] : [])
  .filter(Boolean);
const priorityEmoji = {{priority_emojis_json}};

const allTasks = [];
for (const pagePath of kanbanPages) {
  const page = dv.page(pagePath);
  if (page && page.file.tasks) {
    allTasks.push(...page.file.tasks);
  }
}

function bar(pct) {
  const filled = Math.min(10, Math.max(0, Math.round(pct / 10)))
  return "🟩".repeat(filled) + "⬜".repeat(10 - filled)
}

if (kanbanPages.length === 0 || (allTasks.length === 0 && !dv.page(kanbanPages[0]))) {
  dv.paragraph("{{kanban_not_found}}")
} else {
  try {
    const mappingFileContent = await dv.io.load(mappingFilePath)
    if (!mappingFileContent) {
      dv.paragraph("{{mapping_not_found}}")
      return
    }
    const mappingData = JSON.parse(mappingFileContent)
    const readableMapping = mappingData.readable_mapping || {}
    const tasksById = {}
    const tasksByTitle = {}

    allTasks.forEach(task => {
      let taskId = null
      let taskTitle = null
      if (task.text) {
        const taskIdMatch = task.text.match(/🆔\s*ID[:\s]+([a-f0-9]{8})/i)
        if (taskIdMatch) taskId = taskIdMatch[1]
        const titleMatch = task.text.match(/^- \[[ x]\] (.+?)(?:\n|$)/)
        if (titleMatch) taskTitle = titleMatch[1].trim()
      }
      if (taskId) tasksById[taskId] = task
      if (taskTitle) tasksByTitle[taskTitle] = task
    })

    const goalsStats = {}
    Object.entries(readableMapping).forEach(([taskId, mappingInfo]) => {
      let task = tasksById[taskId]
      if (!task && mappingInfo.task_title) task = tasksByTitle[mappingInfo.task_title]
      const isCompleted = !!(task && task.completed)
      const isOpen = !!(task && !task.completed)
      ;(mappingInfo.goals || []).forEach(goal => {
        const goalId = goal.id
        const goalName = goal.text || "?"
        if (!goalsStats[goalId]) {
          goalsStats[goalId] = { name: goalName, quarter: goal.quarter || "", priority: goal.priority || "", open: 0, done: 0 }
        }
        if (isCompleted) goalsStats[goalId].done++
        else if (isOpen) goalsStats[goalId].open++
      })
    })

    const rows = Object.entries(goalsStats).map(([_, stats]) => {
      const pEmoji = priorityEmoji[stats.priority] || "⚪"
      const qRaw = (stats.quarter || "").trim()
      const quarterLabel = /^Q\d/i.test(qRaw) ? qRaw : (qRaw ? `Q${qRaw}` : "")
      const total = stats.open + stats.done
      const pct = total > 0 ? Math.round((stats.done / total) * 100) : 0
      return [
        `${pEmoji} ${stats.name}`,
        quarterLabel,
        `${bar(pct)} ${pct}%`,
        String(stats.open),
        String(stats.done),
      ]
    }).filter(r => (parseInt(r[3], 10) + parseInt(r[4], 10)) > 0)
    .sort((a, b) => {
      const openDiff = parseInt(b[3], 10) - parseInt(a[3], 10)
      if (openDiff) return openDiff
      const qNum = row => { const m = (row[1] || "").match(/Q(\d)/); return m ? parseInt(m[1], 10) : 99 }
      return qNum(a) - qNum(b)
    })

    if (rows.length > 0) {
      dv.table(["{{table_goal}}", "{{table_quarter}}", "{{table_progress}}", "{{table_open}}", "{{table_done}}"], rows)
    } else {
      dv.paragraph("{{no_mapped_tasks}}")
    }
  } catch (e) {
    dv.paragraph(`{{mapping_error}}: ${e.message}`)
  }
}

const TAG_GOAL = "{{tag_goal}}";
const mappingFilePath = "{{mapping_path}}"
const kanbanPages = ["{{kanban_page}}"]
  .concat("{{kanban_archive_page}}" ? ["{{kanban_archive_page}}"] : [])
  .filter(Boolean);
const priorityEmoji = {{priority_emojis_json}};

const allTasks = [];
for (const pagePath of kanbanPages) {
  const page = dv.page(pagePath);
  if (page && page.file.tasks) {
    allTasks.push(...page.file.tasks);
  }
}

function node(tag, style, text) {
  const el = document.createElement(tag)
  if (style) el.style.cssText = style
  if (text != null) el.textContent = text
  return el
}

function progressCell(pct) {
  const p = Math.max(0, Math.min(100, Number(pct) || 0))
  const t = p / 100
  const c1 = `hsl(142, ${Math.round(42 + t * 28)}%, ${Math.round(70 - t * 26)}%)`
  const c2 = `hsl(142, ${Math.round(48 + t * 30)}%, ${Math.round(46 - t * 16)}%)`
  const row = node("div", "display:flex;align-items:center;gap:10px;min-width:140px;max-width:240px")
  const track = node(
    "div",
    "flex:1;height:14px;border-radius:999px;background:color-mix(in srgb, var(--background-modifier-border) 85%, transparent);box-shadow:inset 0 1px 2px rgba(0,0,0,.08);overflow:hidden"
  )
  track.appendChild(node(
    "div",
    `height:100%;width:${p}%;border-radius:999px;background:linear-gradient(90deg,${c1},${c2})`
  ))
  row.appendChild(track)
  row.appendChild(node(
    "span",
    "flex:0 0 3.2ch;text-align:right;font-variant-numeric:tabular-nums;font-size:0.85em;color:var(--text-muted);font-weight:600",
    `${Math.round(p)}%`
  ))
  return row
}

function goalCell(emoji, name) {
  const wrap = node("span", "display:inline-flex;align-items:flex-start;gap:0.4em;font-weight:600")
  wrap.appendChild(node("span", "flex:0 0 auto;line-height:1.3", emoji))
  wrap.appendChild(node("span", "line-height:1.35", name))
  return wrap
}

function numCell(n) {
  return node("span", "font-variant-numeric:tabular-nums;font-weight:600", String(n))
}

if (kanbanPages.length === 0 || (allTasks.length === 0 && !dv.page(kanbanPages[0]))) {
  dv.paragraph("{{kanban_not_found}}")
} else {
  try {
    const mappingFileContent = await dv.io.load(mappingFilePath)
    if (!mappingFileContent) {
      dv.paragraph("{{mapping_not_found}}")
      return
    }
    const mappingData = JSON.parse(mappingFileContent)
    const readableMapping = mappingData.readable_mapping || {}
    const tasksById = {}
    const tasksByTitle = {}

    allTasks.forEach(task => {
      let taskId = null
      let taskTitle = null
      if (task.text) {
        const taskIdMatch = task.text.match(/🆔\s*ID[:\s]+([a-f0-9]{8})/i)
        if (taskIdMatch) taskId = taskIdMatch[1]
        const titleMatch = task.text.match(/^- \[[ x]\] (.+?)(?:\n|$)/)
        if (titleMatch) taskTitle = titleMatch[1].trim()
      }
      if (taskId) tasksById[taskId] = task
      if (taskTitle) tasksByTitle[taskTitle] = task
    })

    const goalsStats = {}
    Object.entries(readableMapping).forEach(([taskId, mappingInfo]) => {
      let task = tasksById[taskId]
      if (!task && mappingInfo.task_title) task = tasksByTitle[mappingInfo.task_title]
      const isCompleted = !!(task && task.completed)
      const isOpen = !!(task && !task.completed)
      ;(mappingInfo.goals || []).forEach(goal => {
        const goalId = goal.id
        const goalName = goal.text || "?"
        if (!goalsStats[goalId]) {
          goalsStats[goalId] = { name: goalName, quarter: goal.quarter || "", priority: goal.priority || "", open: 0, done: 0 }
        }
        if (isCompleted) goalsStats[goalId].done++
        else if (isOpen) goalsStats[goalId].open++
      })
    })

    const rows = Object.entries(goalsStats).map(([_, stats]) => {
      const pEmoji = priorityEmoji[stats.priority] || "⚪"
      const qRaw = (stats.quarter || "").trim()
      const quarterLabel = /^Q\d/i.test(qRaw) ? qRaw : (qRaw ? `Q${qRaw}` : "")
      const total = stats.open + stats.done
      const pct = total > 0 ? Math.round((stats.done / total) * 100) : 0
      return {
        open: stats.open,
        done: stats.done,
        q: quarterLabel,
        row: [
          goalCell(pEmoji, stats.name),
          quarterLabel,
          progressCell(pct),
          numCell(stats.open),
          numCell(stats.done),
        ],
      }
    }).filter(x => (x.open + x.done) > 0)
    .sort((a, b) => {
      if (b.open !== a.open) return b.open - a.open
      const qNum = q => { const m = (q || "").match(/Q(\d)/); return m ? parseInt(m[1], 10) : 99 }
      return qNum(a.q) - qNum(b.q)
    })
    .map(x => x.row)

    if (rows.length > 0) {
      dv.paragraph("_{{goals_mapping_legend}}_")
      dv.table(["{{table_goal}}", "{{table_quarter}}", "{{table_progress}}", "{{table_open}}", "{{table_done}}"], rows)
    } else {
      dv.paragraph("{{no_mapped_tasks}}")
    }
  } catch (e) {
    dv.paragraph(`{{mapping_error}}: ${e.message}`)
  }
}

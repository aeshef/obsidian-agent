const TAG_FOCUS = "{{tag_focus}}";
const goalsFile = dv.page("{{goals_page}}")

function node(tag, style, text) {
  const el = document.createElement(tag)
  if (style) el.style.cssText = style
  if (text != null) el.textContent = text
  return el
}

/** Coverage / done% — green sequential (success), not alarm. */
function progressCell(pct) {
  const p = Math.max(0, Math.min(100, Number(pct) || 0))
  const t = p / 100
  const c1 = `hsl(142, ${Math.round(42 + t * 28)}%, ${Math.round(70 - t * 26)}%)`
  const c2 = `hsl(142, ${Math.round(48 + t * 30)}%, ${Math.round(46 - t * 16)}%)`
  const row = node("div", "display:flex;align-items:center;gap:10px;min-width:140px;max-width:240px")
  const track = node(
    "div",
    "flex:1;height:14px;border-radius:999px;background:color-mix(in srgb, var(--background-modifier-border) 85%, transparent);box-shadow:inset 0 1px 2px rgba(0,0,0,.08);overflow:hidden"
  )
  track.appendChild(node(
    "div",
    `height:100%;width:${p}%;border-radius:999px;background:linear-gradient(90deg,${c1},${c2})`
  ))
  row.appendChild(track)
  row.appendChild(node(
    "span",
    "flex:0 0 3.2ch;text-align:right;font-variant-numeric:tabular-nums;font-size:0.85em;color:var(--text-muted);font-weight:600",
    `${Math.round(p)}%`
  ))
  return row
}

function numCell(text) {
  return node("span", "font-variant-numeric:tabular-nums;font-weight:600", String(text))
}

if (!goalsFile) {
  dv.paragraph("{{goals_not_found}}")
} else {
  const tasks = goalsFile.file.tasks || []
  const quarters = { Q1: { total: 0, completed: 0 }, Q2: { total: 0, completed: 0 }, Q3: { total: 0, completed: 0 }, Q4: { total: 0, completed: 0 } }

  function hasFocusTag(taskText, quarter) {
    return new RegExp(`#${TAG_FOCUS}/${quarter}\\b`).test(taskText)
  }

  tasks.forEach(task => {
    const taskText = task.text || ""
    ;["Q1", "Q2", "Q3", "Q4"].forEach(q => {
      if (hasFocusTag(taskText, q)) {
        quarters[q].total++
        if (task.completed) quarters[q].completed++
      }
    })
  })

  const rows = ["Q1", "Q2", "Q3", "Q4"].filter(q => quarters[q].total > 0).map(q => {
    const stats = quarters[q]
    const progress = Math.round((stats.completed / stats.total) * 100)
    return [q, numCell(`${stats.completed}/${stats.total}`), progressCell(progress)]
  })

  if (rows.length > 0) {
    dv.table(["{{table_quarter}}", "{{table_goals}}", "{{table_progress}}"], rows)
  } else {
    dv.paragraph("{{no_quarter_focus}}")
  }
}

(async () => {
const TAG_GOAL = "{{tag_goal}}";
const kanbanPages = ["{{kanban_page}}"]
  .concat("{{kanban_archive_page}}" ? ["{{kanban_archive_page}}"] : [])
  .filter(Boolean);
const categories = {{categories_json}};
const catEmoji = {{category_emojis_json}};

const allTasks = [];
for (const pagePath of kanbanPages) {
  const page = dv.page(pagePath);
  if (page && page.file.tasks) {
    allTasks.push(...page.file.tasks);
  }
}

const COMPLETIONS_JSON = "{{dashboards_folder}}/{{data_subdir}}/task_completions.json";
const DAY_MS = 86400000;
const cutoff = Date.now() - 30 * DAY_MS;
const DONE_COL = "{{done_column}}";

async function readVaultFile(path) {
  try { return await dv.io.load(path) } catch (_) {}
  try {
    const f = app.vault.getAbstractFileByPath(path);
    if (f) return await app.vault.read(f);
  } catch (_) {}
  return null;
}

async function loadCompletionByTaskId() {
  const map = {};
  const put = (tid, ts) => {
    if (!tid || ts == null || Number.isNaN(ts)) return;
    const k = String(tid).toLowerCase();
    if (!map[k] || ts > map[k]) map[k] = ts;
  };
  try {
    const rawText = await readVaultFile(COMPLETIONS_JSON);
    if (rawText) {
      const payload = JSON.parse(rawText);
      const raw = payload.completions || payload;
      for (const [tid, iso] of Object.entries(raw)) {
        put(tid, Date.parse(String(iso).replace(" ", "T")));
      }
      if (Object.keys(map).length) return map;
    }
  } catch (_) {}
  const LOG_DIR = "{{dashboards_folder}}/{{logs_subdir}}";
  const LOG_PREFIX = "{{action_log_prefix}}";
  const entryRe = /^## (\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\s*\n+\*\*(?:Тип|Type):\*\* (.+?)\s*\n+\*\*(?:Данные|Data):\*\*\s*\n```json\n([\s\S]*?)\n```/gm;
  const now = new Date();
  for (let i = 0; i < 13; i++) {
    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    const ym = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;
    const path = `${LOG_DIR}/${LOG_PREFIX}${ym}.md`;
    const content = await readVaultFile(path);
    if (!content) continue;
    let m;
    while ((m = entryRe.exec(content)) !== null) {
      const typ = m[2].trim();
      let data;
      try { data = JSON.parse(m[3]); } catch { continue; }
      const ts = Date.parse(m[1].replace(" ", "T"));
      const tid = data.task_id;
      if (typ === "task_completed") put(tid, ts);
      else if (typ === "task_moved" && data.to === DONE_COL) put(tid, ts);
    }
  }
  return map;
}

async function buildLineCache(tasks) {
  const cache = {};
  const paths = [...new Set(tasks.map(t => t.path).filter(Boolean))];
  for (const path of paths) {
    const content = await readVaultFile(path);
    if (content) cache[path] = content.split("\n");
  }
  return cache;
}

function goalCategory(task) {
  const text = task.text || "";
  const m = text.match(new RegExp(`#${TAG_GOAL}/([^\\s#]+)`));
  if (m) return m[1];
  const prefix = `${TAG_GOAL}/`;
  for (const tag of (task.tags || [])) {
    const t = String(tag);
    if (t.startsWith(prefix)) return t.slice(prefix.length);
  }
  return null;
}

function taskIdFrom(task, lineCache) {
  const m = (task.text || "").match(/🆔\s*ID[:\s]+([a-f0-9]{8})/i);
  if (m) return m[1].toLowerCase();
  const lines = lineCache[task.path];
  if (!lines) return null;
  const start = Math.max(0, (task.line || 1) - 1);
  for (let i = start; i < Math.min(lines.length, start + 12); i++) {
    const mm = lines[i].match(/🆔\s*ID[:\s]+([a-f0-9]{8})/i);
    if (mm) return mm[1].toLowerCase();
  }
  return null;
}

function completionTs(task, completionById, lineCache) {
  if (task.completion) {
    const t = task.completion.ts ?? Date.parse(task.completion);
    if (t && !Number.isNaN(t)) return t;
  }
  const text = task.text || "";
  const mark = text.match(/✅\s*(\d{4}-\d{2}-\d{2})/);
  if (mark) {
    const t = Date.parse(mark[1]);
    if (t && !Number.isNaN(t)) return t;
  }
  const tid = taskIdFrom(task, lineCache);
  if (tid && completionById[tid]) return completionById[tid];
  const sec = task.section;
  const secStr = sec ? (sec.subpath || sec.path || String(sec)) : "";
  const ym = String(secStr).match(/(\d{4})-(\d{2})/);
  if (ym) {
    const y = parseInt(ym[1], 10);
    const mo = parseInt(ym[2], 10);
    return Date.UTC(y, mo - 1, 15);
  }
  return null;
}

function node(tag, style, text) {
  const el = document.createElement(tag)
  if (style) el.style.cssText = style
  if (text != null) el.textContent = text
  return el
}

/** Category label: emoji + name, never wraps mid-row. */
function catCell(emoji, name) {
  const wrap = node("span", "display:inline-flex;align-items:center;gap:0.45em;white-space:nowrap;font-weight:600")
  wrap.appendChild(node("span", "flex:0 0 auto;line-height:1", emoji))
  wrap.appendChild(node("span", "line-height:1.2", name))
  return wrap
}

/** Hero count — what you act on. */
function openCell(n, stale) {
  const el = node(
    "span",
    `font-variant-numeric:tabular-nums;font-weight:700;font-size:1.1em;${stale ? "color:var(--text-error,#e11d48)" : ""}`,
    String(n)
  )
  return el
}

/**
 * Portfolio share bar (industry WIP-by-type):
 * width = open / totalOpen. Heat encodes concentration.
 * Number lives in «Открыто», not glued to the track.
 */
function shareCell(share) {
  const pct = Math.round(share * 1000) / 10 // one decimal when needed
  const pctLabel = Number.isInteger(pct) ? `${pct}%` : `${pct.toFixed(1)}%`
  const fillPct = Math.max(0, Math.min(100, share * 100))

  // Sequential indigo: more share = denser blue (magnitude, not alarm).
  // Alarm stays on the Open number (stale), not on the bar hue.
  const t = Math.max(0, Math.min(1, share / 0.45))
  const c1 = `hsl(234, ${Math.round(48 + t * 30)}%, ${Math.round(72 - t * 28)}%)`
  const c2 = `hsl(234, ${Math.round(55 + t * 28)}%, ${Math.round(58 - t * 26)}%)`
  const fill = `linear-gradient(90deg,${c1} 0%,${c2} 100%)`

  const row = node("div", "display:flex;align-items:center;gap:10px;min-width:160px;max-width:280px")
  const track = node(
    "div",
    "flex:1;height:14px;border-radius:999px;background:color-mix(in srgb, var(--background-modifier-border) 85%, transparent);box-shadow:inset 0 1px 2px rgba(0,0,0,.08);overflow:hidden"
  )
  const bar = node(
    "div",
    `height:100%;width:${fillPct}%;border-radius:999px;background:${fill};box-shadow:0 0 0 1px rgba(0,0,0,.04);transition:width .2s ease`
  )
  track.appendChild(bar)
  const label = node(
    "span",
    "flex:0 0 3.6ch;text-align:right;font-variant-numeric:tabular-nums;font-size:0.85em;color:var(--text-muted);font-weight:600",
    pctLabel
  )
  row.appendChild(track)
  row.appendChild(label)
  return row
}

function numCell(n) {
  return node("span", "font-variant-numeric:tabular-nums;font-weight:500", String(n))
}

if (kanbanPages.length === 0 || allTasks.length === 0 && !dv.page(kanbanPages[0])) {
  dv.paragraph("{{kanban_not_found}}")
} else {
  const completionById = await loadCompletionByTaskId();
  const lineCache = await buildLineCache(allTasks);
  const categoryStats = {}
  categories.forEach(cat => { categoryStats[cat] = { open: 0, done30: 0, doneAll: 0 } })

  allTasks.forEach(task => {
    const category = goalCategory(task)
    if (!category || !categoryStats[category]) return
    if (task.completed) {
      categoryStats[category].doneAll++
      const ts = completionTs(task, completionById, lineCache)
      if (ts != null && ts >= cutoff) categoryStats[category].done30++
    } else {
      categoryStats[category].open++
    }
  })

  const active = categories
    .map(cat => ({ cat, s: categoryStats[cat] }))
    .filter(({ s }) => (s.open + s.doneAll) > 0)

  const totalOpen = active.reduce((sum, { s }) => sum + s.open, 0)
  const totalDone30 = active.reduce((sum, { s }) => sum + s.done30, 0)

  // Sort by open DESC — pressure first (standard WIP triage).
  active.sort((a, b) => b.s.open - a.s.open || b.s.done30 - a.s.done30)

  const rows = active.map(({ cat, s }) => {
    const emoji = (catEmoji && catEmoji[cat]) ? catEmoji[cat] : "📌"
    const share = totalOpen > 0 ? s.open / totalOpen : 0
    // Stale stock: high open, weak 30d throughput.
    const stale = s.open >= 8 && (s.done30 / Math.max(s.open, 1)) < 0.15
    return [
      catCell(emoji, cat),
      openCell(s.open, stale),
      shareCell(share),
      numCell(s.done30),
      numCell(s.doneAll),
    ]
  })

  if (rows.length > 0) {
    const summary = node(
      "div",
      "display:flex;flex-wrap:wrap;gap:12px 20px;margin:0 0 10px;font-variant-numeric:tabular-nums;color:var(--text-muted);font-size:0.92em"
    )
    summary.appendChild(node("span", "", `{{label_wip_total_open}}: ${totalOpen}`))
    summary.appendChild(node("span", "", `{{label_wip_total_done30}}: ${totalDone30}`))
    summary.appendChild(node("span", "", `{{label_wip_categories}}: ${rows.length}`))
    dv.container.appendChild(summary)

    dv.table(
      ["{{table_category}}", "{{table_open}}", "{{table_wip_bar}}", "{{table_done_30d}}", "{{table_done_all}}"],
      rows
    )
    dv.paragraph("_{{category_wip_legend}}_")
  } else {
    dv.paragraph("{{no_categorized_tasks}}")
  }
}
})();

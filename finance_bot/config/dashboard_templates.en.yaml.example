# cp via scripts/setup/materialize_locale.py (AGENT_LOCALE=en)

title: "# 📊 Finance"

errors:
  db_not_found: |
    # 📊 Finance

    ⚠️ Database not found: `{db_path}`

    Run sync:
    ```bash
    cd /path/to/finance_bot && ./scripts/sync_finance_db.sh
    ./scripts/run_finance_dashboard.sh
    ```
  db_not_found_log: "DB not found. Wrote stub: {out_path}"

logs:
  loaded: "Loaded: {accounts} accounts, {transactions} txns, {planned} plans"
  written: "Written: {out_path}"

misc:
  no_due_date: "no due date"
  unknown_account: "Unknown"
  dash: "—"
  other_category: "Other"
  rest_category: "Rest"

sections:
  summary:
    heading: "## 💰 Summary"
    db_updated: "- **finance.db updated:** {mtime}"
    stale_data: |
      - ⚠️ **Stale data** (DB from {mtime}). Run `./scripts/sync_finance_db.sh` then rebuild the dashboard.
    total_rub: "- **Total balance (RUB):** {amount}"
    total_usd: "- **Total balance (USD):** {amount}"

  planned:
    heading: "### 📋 Planned expenses"
    line: "- **{name}**: {amount} {currency} (due {due})"
    hint: "_Add plans in the bot: 📋 Plan → ➕ Add plan_"

  structure:
    heading: "### Balance structure (RUB)"
    pie_title: "Where money sits (RUB)"
    pie_label: "{name} — {amount}"

  expenses:
    month_heading: "### Spending by category (current month, incl. one-offs)"
    month_pie_title: "Spending {month}"
    regular_heading: "### Regular spending by category (current month)"
    regular_pie_title: "Regular spending {month} (under {threshold:,} RUB)"
    all_heading: "### Spending by category (all time)"
    all_pie_title: "Spending (all time)"
    empty_heading: "### Spending by category"
    empty_hint: "_No expenses yet. Log them in the bot — charts appear here._"

  moves:
    heading: "### ↔️ Transfers (not spending)"
    excluded_cats: "_Categories excluded from income/expense: {cats}._"
    out_month: "- **Transferred out (month):** {amount} RUB"
    in_month: "- **Transferred in (month):** {amount} RUB"
    net: "- **Net (control):** {amount} RUB"
    recent_header: "Recent transfers (control):"
    table_header: "| Dir. | Account | Category | Amount | Date | Comment |"
    table_sep: "|------|---------|----------|--------|------|---------|"

  daily_regular:
    heading: "### Daily spending (categories)"
    threshold_note: "_One-off threshold: ≥ {threshold:,} RUB (excluded from this chart)._"
    badge_note: "_Badge ({category}) is in its own section below — not shown here._"
    last_spend: "_Last regular expense in DB: **{date}**."
    last_spend_gap: "_Last regular expense: **{date}** ({gap} days ago — trailing zeros mean no bot entries, not a bug)._"
    no_data: "_Not enough data for chart._"
    empty_heading: "### Daily spending"
    empty_hint: "_Add expenses via the bot — chart builds automatically._"

  daily_oneoff:
    heading: "### Large one-off expenses (by day)"
    threshold_note: "_Threshold: ≥ {threshold:,} RUB._"

  daily_flow:
    heading: "### Daily income and expense (RUB)"
    empty_heading: "### Daily income and expense"
    empty_hint: "_No transactions in range — chart appears after bot entries._"
    weekly_heading: "### Weekly income and expense (RUB)"
    weekly_exp_heading: "### Weekly spending (categories, regular)"

  balance:
    heading: "### End-of-day balance (RUB)"
    description: |
      _**Cards and wallets** — internal RUB accounts (DB + daily txns). **Broker** — portfolio snapshots. **Total** — cards + broker + other external RUB without daily history (flat at current balance); last «Total» point matches header «Total balance (RUB)»._
    axis_note: "_Axis: {from_date} → {to_date} ({days} d) · last day: **total {total}** RUB (cards {cards}, broker {broker}) · built: {built_at}_"
    no_data: "_Not enough data._"

  by_account:
    heading: "### Spending by account"
    pie_title: "Where we spend (all time)"

  balances_table:
    heading: "### Balances by account"
    header: "| Account | Balance | Currency |"
    sep: "|---------|---------|----------|"

  top_expenses:
    heading: "### Top expenses (30 days)"
    header: "| Account | Category | Amount | Date | Comment |"
    sep: "|---------|----------|--------|------|---------|"

  quarterly:
    heading: "### Quarterly income/expense"
    hint: "_Quarterly totals — for seasonal planning._"

  oneoff_list:
    heading: "### 🧱 Large one-offs (list)"
    hint: "_Expenses ≥ {threshold:,} RUB. Excluded from regular charts above._"
    header: "| Account | Category | Amount | Date | Comment |"
    sep: "|---------|----------|--------|------|---------|"

  monthly:
    heading: "### Monthly income and expense"
    empty_hint: "_No transactions — log in the bot to see the chart._"

footer:
  refresh: |
    ---

    **Force refresh:** from `finance_bot` run `./scripts/run_finance_dashboard_daily.sh`.

charts:
  daily_categories_file: "Spending_by_day_category.png"
  daily_categories_title: "Regular daily spending by category"
  oneoff_daily_file: "Large_oneoff_by_day.png"
  oneoff_daily_title: "Large one-off expenses by day"
  oneoff_series: "One-offs"
  flow_daily_file: "Income_expense_by_day.png"
  flow_daily_title: "Daily income and expense"
  flow_weekly_file: "Income_expense_by_week.png"
  flow_weekly_title: "Weekly income and expense"
  exp_weekly_file: "Spending_by_week_category.png"
  exp_weekly_title: "Regular weekly spending by category"
  balance_daily_file: "Total_balance_by_day.png"
  balance_daily_title: "End-of-day balance: cards, broker, total"
  quarterly_file: "Income_expense_by_quarter.png"
  quarterly_title: "Quarterly income and expense"
  monthly_file: "Income_expense_by_month.png"
  monthly_title: "Monthly income and expense"
  period_xlabel: "Period"
  income: "Income"
  expense: "Expense"
  cards_rub: "Cards and wallets (RUB)"
  broker_rub: "Broker (RUB)"
  total_rub: "Total (RUB)"

# 0 = full history from first data point on each chart; >0 = rolling window in days/weeks
chart_windows:
  daily_spending_days: 0
  daily_oneoff_days: 0
  daily_flow_days: 0
  balance_days: 0
  weekly_flow_weeks: 0
  weekly_spending_weeks: 0

category_order:
  - "Food/Groceries"
  - "Food/Eating out"
  - "Food/Badge"
  - "Transport/Taxi"
  - "Transport/Transit"
  - "Home/Utilities"
  - "Home/Household"
  - "Health"
  - "Clothing"
  - "IT"
  - "Learning"
  - "Entertainment"
  - "Gifts"
  - "Subscriptions"
  - "Other"

badge:
  no_account: "_Badge account not created — log first meal in the bot (🍽 Badge)._"
  working_days: "- **Working days:** {days}"
  spent: "- **Spent:** {spent} ₽ of {entitlement} ₽ ({pct:.0f}%)"
  burned: "- **Quota burned:** {amount} ₽"
  ndfl: "- **Estimated tax on spend:** ~{amount} ₽"
  zero_days: "- **Days with full quota burn:** {days}"
  over_limit: "- **Over daily limit:** {amount} ₽"
  chart_file: "Badge_utilization_by_day.png"
  chart_spent: "Spent"
  chart_burned: "Burned"
  chart_title: "Badge: spent vs burned quota by working day"
  default_title: "🍽 Meal badge"

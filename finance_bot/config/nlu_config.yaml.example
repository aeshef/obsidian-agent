# NLU finance — скопируйте в nlu_config.yaml (рабочий файл не в git, см. CONTRIBUTING.md)

account_type_card_hints:
  - карт
  - card

broker_categories:
  topup: "Пополнение брокера"
  withdraw: "Вывод с брокера"
  fee: "Комиссия брокера"

min_text_length: 3

# Точные команды, которые не должны обрабатываться NLU (должны совпадать с handlers)
exact_commands:
  - "Синк Тинькофф"

# Кнопки главного меню (не NLU; подписи настраиваются под ваш UI)
menu_buttons:
  - "➖ Добавить расход"
  - "➕ Добавить доход"
  - "↔️ Перевод"
  - "💼 Долги"
  - "📈 Инвестиции"
  - "📊 Баланс"
  - "🧾 Последние операции"
  - "📊 Суммаризация"
  - "🔄 Синхронизация"
  - "📋 План/Прогноз"

# NLU finance — скопируйте в nlu_config.yaml (рабочий файл может быть локальным).

# Устарело: gate по keywords снят; распознавание только через nlu_prompt.txt + LLM
transaction_keywords: []

account_type_card_hints:
  - карт
  - card

broker_categories:
  topup: "Пополнение брокера"
  withdraw: "Вывод с брокера"
  fee: "Комиссия брокера"

min_text_length: 3

exact_commands:
  - "Синк Тинькофф"

menu_buttons:
  - "➖ Добавить расход"
  - "➕ Добавить доход"
  - "↔️ Перевод"
  - "💼 Долги"
  - "📈 Инвестиции"
  - "📊 Баланс"
  - "🧾 Последние операции"
  - "📊 Суммаризация"
  - "🔄 Синхронизация"
  - "📋 План/Прогноз"

user_context_template: |
  [REDACTED]

  Типичные операции:
  - Переводы между счетами
  - Пополнение/вывод брокера
  - Траты и доходы (указывай точные имена счетов и категорий из списков выше)
  - Долги

# NLU finance — скопируйте в nlu_config.yaml (рабочий файл не в git, см. CONTRIBUTING.md)

account_type_card_hints:
  - карт
  - card

account_type_wallet_cash_hints:
  - нал
  - cash

broker_categories:
  topup: "Пополнение брокера"
  withdraw: "Вывод с брокера"
  fee: "Комиссия брокера"

min_text_length: 3

# Текст отмены pending confirm (помимо common.cancel_button из messages)
cancel_text_aliases:
  - отмена
  - cancel

# Точные команды, которые не должны обрабатываться NLU (должны совпадать с handlers)
exact_commands:
  - "Синк Тинькофф"

# Кнопки reply-меню (опционально; по умолчанию — balance, last_ops)
# invest/plan — через агента и свободный текст
# menu_buttons:
#   - "📊 Баланс"
#   - "🧾 Последние операции"

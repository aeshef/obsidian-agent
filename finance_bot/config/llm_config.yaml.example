# cp finance_bot/config/llm_config.yaml.example finance_bot/config/llm_config.yaml
# Конфигурация для LLM клиента

# Базовый URL API
base_url: "https://api.deepseek.com/v1"

# Модель по умолчанию
default_model: "deepseek-chat"

# Температура для разных типов запросов
temperature:
  json: 0.3  # Для структурированных ответов (JSON)
  text: 0.7  # Для текстовых ответов (summary)

# Таймауты (в секундах)
timeout:
  default: 60.0
  json: 120.0  # длинные пачки транзакций
  text: 60.0

# Лимит токенов ответа (batch NLU)
max_tokens:
  nlu: 8192

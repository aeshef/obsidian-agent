# Corporate meal / food-benefit tracking.
#   cp config/badge.yaml.example config/badge.yaml
# Only the example is in git. Local badge.yaml is gitignored / deployed if present.

enabled: false

account_name: "Meal Badge"
category: "Food/Badge"
exclude_from_balance: true

# Daily entitlement in your ledger currency (alias: daily_limit_rub).
daily_limit: 15
# Optional payroll tax on in-limit spend (e.g. RU personal income tax). 0 = off.
ndfl_rate: 0

extra_non_working_days: []
extra_working_days: []

rules_context: |
  Workplace meal benefit: each working day receives a daily limit.
  Unused daily remainder burns (does not roll over).
  Optional income tax on in-limit spend is controlled by ndfl_rate (0 = none).

ui:
  menu_button: "🍽 Badge"
  quick_amounts: []
  amount_prompt: |
    Enter amount and place on one line.
    Example: 12.50 cafeteria
  dashboard_hint: "Charts: Obsidian finance dashboard → Meal badge section"

coaching:
  month_burn_warn_pct: 25
  tips:
    over_limit: "Over today's limit by {over} — usually payroll-deducted."
    quota_left: "{remaining} of today's quota left before midnight."
    month_burn: "Burned {burned} of quota this month ({burn_pct}%)."
    ndfl_month: "Estimated tax on in-limit spend this month: ~{ndfl}."

alerts:
  evening_hour: 19
  evening_minute: 0
  burn_threshold_pct: 40
  overspend_notify: true

llm:
  after_spend_enabled: true
  evening_enabled: false
  monthly_digest_enabled: true
  after_spend_prompt: |
    You coach a workplace meal benefit. Reply in 1–2 sentences, no Markdown.
    Rules:
    {rules_context}
    Daily limit: {daily_limit}. Tax rate setting: {ndfl_pct}%.
    Just logged: {amount}, note: {comment}.
    Today after spend: spent {spent_today}, over limit {over_today}.
    Month: spent {spent_month} of {entitlement_month}, burned {burned_month}.
    One practical tip.
  monthly_digest_prompt: |
    Plain text only, no Markdown.
    Meal-benefit month review. Rules:
    {rules_context}
    JSON: {month_stats_json}
    Daily limit {daily_limit}, tax setting {ndfl_pct}%.
    2–4 sentences: outcome, burn, tax if any, one tip.

dashboard:
  section_title: "🍽 Meal badge"
  show_ndfl_estimate: false
  chart_days: 31

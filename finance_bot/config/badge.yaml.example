# Трекинг корпоративного бейджа питания. Скопируйте в badge.yaml и настройте под себя.
#   cp config/badge.yaml.example config/badge.yaml
# В git только этот example. Боевой config/badge.yaml — локально и на VPS
# (deploy.sh rsync-ит badge.yaml на сервер, если файл есть у вас в finance_bot/config/).

enabled: false

account_name: "Meal Badge"
category: "Еда/Бейдж"
exclude_from_balance: true

daily_limit_rub: 1000
ndfl_rate: 0.13

extra_non_working_days: []
extra_working_days: []

# Контекст правил для LLM (не хардкод в коде). Подставляется в промпты как {rules_context}
rules_context: |
  Корпоративный бейдж питания: на каждый рабочий день месяца начисляется дневной лимит.
  Непотраченный остаток дня сгорает, на следующий день не переносится.
  Траты в рамках дневного лимита облагаются НДФЛ (удержание из зарплаты).
  Сверх дневного лимита (если снят cap) удерживается из ЗП в следующем месяце, на сверхлимит НДФЛ не начисляется.
  Цель: не терять квоты впустую и не раздувать перерасход/НДФЛ.

ui:
  menu_button: "🍽 Бейдж"
  # Пустой список = без круглых кнопок, только ввод суммы
  quick_amounts: []
  amount_prompt: |
    Введите сумму и место одной строкой.
    Пример: 347 вендомат
    или: 1297 лавка
  dashboard_hint: "График и месяц: Obsidian → 📊 Финансы_Дашборд.md → «Бейдж питания»"

# Пороги и шаблоны подсказок после траты (подстановки: {remaining}, {over}, {burned}, {burn_pct}, {ndfl})
coaching:
  month_burn_warn_pct: 25
  tips:
    over_limit: "Сверх лимита сегодня {over} ₽ — уйдёт в удержание из ЗП (на эту часть НДФЛ нет)."
    quota_left: "До полуночи ещё {remaining} ₽ квоты — иначе сгорят."
    month_burn: "В месяце уже сгорело {burned} ₽ квот ({burn_pct}% от начисленного) — это «потерянный» бенефит."
    ndfl_month: "Оценка НДФЛ с трат за месяц: ~{ndfl} ₽ из зарплаты."

alerts:
  evening_hour: 19
  evening_minute: 0
  # Вечером напомнить, если потрачено меньше этого % дневного лимита
  burn_threshold_pct: 40
  overspend_notify: true

llm:
  # Короткий совет после каждой записи (1–2 предложения, без Markdown)
  after_spend_enabled: true
  # Вечерний пуш — по умолчанию только расчёт; true = дополнить советом LLM
  evening_enabled: false
  # 1-е число — итоги месяца (используется в scheduler)
  monthly_digest_enabled: true
  after_spend_prompt: |
    Ты коуч по бейджу питания. Отвечай 1–2 предложениями, без Markdown.
    Правила:
    {rules_context}
    Дневной лимит: {daily_limit} ₽. НДФЛ: {ndfl_pct}% с трат в лимите.
    Только что записана трата: {amount} ₽, комментарий: {comment}.
    Сегодня после траты: потрачено {spent_today} ₽, сверх лимита {over_today} ₽.
    Месяц: потрачено {spent_month} из {entitlement_month} ₽, сгорело квот {burned_month} ₽.
    Дай один практический совет: сжечь остаток квоты, не раздувать перерасход, или спокойно — если норм.
  monthly_digest_prompt: |
    КРИТИЧЕСКИ ВАЖНО: только обычный текст, без Markdown.
    Анализ бейджа за прошлый месяц. Правила:
    {rules_context}
    Данные JSON: {month_stats_json}
    Дневной лимит {daily_limit} ₽, НДФЛ {ndfl_pct}%.
    2–4 предложения: итог, сгорание квот, НДФЛ, один совет на следующий месяц.

dashboard:
  section_title: "🍽 Бейдж питания"
  show_ndfl_estimate: true
  chart_days: 31

# Категории для аналитики / дашборда (переопределение env — см. finance_classification.py)
# cp analytics_categories.yaml.example analytics_categories.yaml

exclude_spending: "Перевод,Переводы,Пополнение брокера"
exclude_income: "Перевод,Переводы,Вывод с брокера"

# Real earned income for plans/gauges (everything else non-excluded is not salary).
salary_income: "Зарплата"
# Non-salary income that offsets group pays («скинулись»), not gifts/windfalls.
reimbursement_income: "Прочее,Долги"

investment_expense:
  - Пополнение брокера
  - Инвестиции
  - Broker
  - ИИС
  - Копилка
  - Накопления
  - Сбережения

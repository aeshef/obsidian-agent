# Copy to initial_accounts.yaml and fill in your data.
# initial_accounts.yaml is gitignored (this example is the public template).

# Numeric Telegram ID (@userinfobot or logs after /start)
telegram_id: YOUR_TELEGRAM_NUMERIC_ID

accounts:
  - name: "Primary card"
    balance: 0
    currency: "USD"
    type: "card"

  - name: "Cash"
    balance: 0
    currency: "USD"
    type: "wallet"

# cp broker_sync.yaml.example broker_sync.yaml
# provider: tinkoff | example | none — none disables API sync even if broker_sync connector is on
# Rename labels.* to match your broker account names in the finance DB.

# Implemented: tinkoff. Template stub: example. Extend in shared/finance/broker_providers.py
provider: tinkoff

accounts:
  regular: true
  iis: true
  invest_box: true

labels:
  regular: "Broker (regular)"
  iis: "Broker (ISA)"
  invest_box: "Broker (invest box)"

legacy:
  orphan_names:
    - "Broker (ISA)"
    - "Broker (regular)"
  suffixed_prefixes:
    - "Broker (regular) "
    - "Broker (ISA) "
    - "Broker (invest box) "

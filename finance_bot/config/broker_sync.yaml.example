# cp broker_sync.yaml.example broker_sync.yaml
# provider: tinkoff | none — none disables API sync even if broker_sync connector is on
# accounts: per-kind toggles (regular / iis / invest_box); also overridable via capabilities features

# Supported today: tinkoff. Extension point: add provider in shared/finance/broker_portfolio_sync.py
provider: tinkoff

accounts:
  regular: true
  iis: true
  invest_box: true

labels:
  regular: "Тинькофф Брокер"
  iis: "Тинькофф ИИС"
  invest_box: "Тинькофф Invest Box"

legacy:
  orphan_names:
    - "Тинькофф ИИС"
    - "Тинькофф Брокер"
  suffixed_prefixes:
    - "Тинькофф Брокер "
    - "Тинькофф ИИС "
    - "Тинькофф Invest Box "

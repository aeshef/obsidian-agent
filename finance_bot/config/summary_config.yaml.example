# cp finance_bot/config/summary_config.yaml.example finance_bot/config/summary_config.yaml
# Конфигурация для генерации суммаризации

# Количество категорий в топе
top_categories_limit: 5

# Периоды (в днях)
periods:
  week: 7
  month: 30

# Fallback сообщение при ошибке генерации
fallback_message: "Не удалось сгенерировать суммаризацию."

# cp dashboard_templates.yaml.example dashboard_templates.yaml
# Finance dashboard markdown/chart labels (Cyrillic allowed here, not in .py).

title: "# 📊 Финансы"

nav_callout: |
  > [!abstract] Дашборды
  > [[🎯 Главный_Дашборд|🎯 Главный]] · [[📊 Прогресс_2026|📊 Прогресс]] · [[🏥 Здоровье|🏥 Здоровье]] · [[🔬 Аналитика|🔬 Аналитика]] · [[📅 Встречи_и_фокус_недели|📅 Встречи]] · [[🛠 Система|🛠 Система]]

callouts:
  badge: "🍽 Бейдж питания"
  day_oneoff: "🏔 Крупные разовые траты"
  account_details: "💳 Детали по счетам"
  top_expenses: "🏷️ Топ трат за 30 дней"

errors:
  db_not_found: |
    # 📊 Финансы

    ⚠️ БД не найдена: `{db_path}`

    Запусти синхронизацию:
    ```bash
    cd /path/to/finance_bot && ./scripts/sync_finance_db.sh
    ./scripts/run_finance_dashboard.sh
    ```
  db_not_found_log: "DB not found. Wrote stub: {out_path}"

logs:
  loaded: "Loaded: {accounts} accounts, {transactions} txns, {planned} plans"
  written: "Written: {out_path}"

misc:
  no_due_date: "без срока"
  unknown_account: "Неизвестно"
  dash: "—"
  other_category: "Прочее"
  rest_category: "Остальное"

sections:
  summary:
    heading: "## 💰 Сводка"
    db_updated: "_Данные · {mtime}_"
    stale_data: |
      > [!warning] Данные устарели (БД от {mtime}). Обнови: `./scripts/sync_finance_db.sh`, затем пересобери дашборд.
    total_rub: "**{amount}** ₽"
    total_usd: "**${amount}**"
    runway_months: "Runway **{months}** мес"
    hero_open: >
      > [!abstract] Сейчас
    hero_rub: "> ### {amount} ₽"
    hero_meta: "> {meta}"
    hero_updated: "> _{mtime}_"

  planned:
    heading: "### 📋 Запланированные расходы"
    line: "- **{name}**: {amount} {currency} (к {due})"
    hint: "_Добавляй планы в боте: 📋 План → ➕ Добавить план_"

  month_plan:
    heading: "### 📅 План месяца"
    gauges_note: "> ₽/день — только от зарплаты (income − фикс − накопления %). Кэш = подушка/runway · брокер = капитал."
    free_open: "> [!{kind}] Свободно на жизнь (от зарплаты)"
    free_title: "> ### {amount} ₽"
    free_meta: "> Пул **{pool}** · уже из пула **{spent}** ({burn}%) · ≈ **{daily}** ₽/день · {days} дн."
    buffer_open: "> [!{kind}] Накопления (pay yourself first)"
    buffer_title: "> ### {progress} / {goal} ₽"
    buffer_meta: "> **{rate}%** зарплаты = **{goal}** · в брокер **{invest}** · **{status}**"
    safety_open: "> [!{kind}] Подушка (кэш, не брокер)"
    safety_title: "> ### {runway} мес runway"
    safety_meta: "> Кэш **{cash}** · брокер **{broker}** · essentials **{essentials}**/мес · после разовых **{after}** · цель **{target}** мес → gap **{gap}**"
    income_callout_open: "> [!success] Flexible pool (от зарплаты)"
    income_callout_title: "> ### {amount} ₽ на месяц"
    income: "- Ожидаемый доход: **{amount}** ₽"
    commitment: "- Обязательства (фикс + планы + накопления %): **{amount}** ₽"
    flexible: "- Flexible pool: **{amount}** ₽"
    spent: "- Уже потрачено из flexible: **{amount}** ₽ ({burn}%)"
    daily: "- Сегодня можно ≈ **{amount}** ₽/день (от зарплаты)"
    fair_daily: "- Справедливая норма на день: **{amount}** ₽"
    specifics_heading: "**В этом месяце (разовые планы):**"
    specifics_line: "- {name}: {amount} {currency}"
    upcoming_heading: "**Позже:**"
    upcoming_line: "- {name}: {amount} {currency} (к {due})"
    hint: "_План: бот 📋 План + `month_plan.yaml` (зарплата / savings_rate_pct). Кэш ≠ дневной бюджет._"
    skip_income_zero: "> [!note] Дневной лимит от дохода\n> Заполни `income_expected_rub` — появятся flexible pool и ₽/день. Подушка ниже — runway кэша, не разрешение тратить баланс."

  structure:
    heading: ""
    pie_title: "Где лежат деньги (RUB)"
    pie_label: "{name}"

  expenses:
    month_heading: "## 💸 Этот месяц"
    month_pie_title: "Траты {month}"
    regular_heading: "### Обычные траты (без разовых)"
    regular_pie_title: "Обычные траты {month} (до {threshold:,} RUB)"
    all_heading: "### Все категории"
    all_pie_title: "Траты (всего)"
    empty_heading: "## 💸 Этот месяц"
    empty_hint: "_Пока нет трат. Записывай расходы в боте — график появится здесь._"

  moves:
    heading: "### ↔️ Перемещения (не траты)"
    excluded_cats: "_Категории, исключённые из трат/доходов: {cats}._"
    out_month: "- **Перемещено (из счетов), месяц:** {amount} RUB"
    in_month: "- **Перемещено (на счета), месяц:** {amount} RUB"
    net: "- **Разница (контроль):** {amount} RUB"
    recent_header: "Последние перемещения (для контроля):"
    table_header: "| Напр. | Счёт | Категория | Сумма | Дата | Комментарий |"
    table_sep: "|------|------|-----------|-------|------|-------------|"

  daily_regular:
    heading: "## 📊 По категориям"
    threshold_note: "_Порог “разовых”: ≥ {threshold:,} RUB (исключены из этого графика)._"
    badge_note: "_Бейдж ({category}) вынесен в отдельную секцию ниже — здесь не показывается._"
    last_spend: "_Последняя «обычная» трата в БД: **{date}**."
    last_spend_gap: "_Последняя «обычная» трата в БД: **{date}** ({gap} дн. назад — нули на хвосте = нет записей в боте, не баг графика)."
    no_data: "_Недостаточно данных для графика._"
    empty_heading: "## 📊 По категориям"
    empty_hint: "_Добавь траты через бота — график построится автоматически._"

  daily_oneoff:
    heading: "### Разовые крупные траты (по дням)"
    threshold_note: "_Порог: ≥ {threshold:,} RUB._"

  daily_flow:
    heading: "## 📈 Потоки"
    empty_heading: "## 📈 Потоки"
    empty_hint: "_Нет транзакций за период — график появится после записей в боте._"
    weekly_heading: "### По неделям"
    weekly_exp_heading: "### Траты по неделям"

  balance:
    heading: "## 💹 Баланс"
    description: ""
    axis_note: "_{from_date} → {to_date} · итого **{total}** RUB_"
    no_data: "_Недостаточно данных._"

  by_account:
    heading: "### Откуда тратим"
    pie_title: "Откуда тратим (всего)"

  balances_table:
    heading: "### По счетам"
    header: "| Счёт | Баланс | Валюта |"
    sep: "|------|--------|--------|"

  top_expenses:
    heading: "### Топ трат за 30 дней"
    header: "| Счёт | Категория | Сумма | Дата | Комментарий |"
    sep: "|------|-----------|-------|------|-------------|"

  quarterly:
    heading: "### По кварталам"
    hint: "_Доход и расход по кварталам — для сезонного планирования._"

  oneoff_list:
    heading: "### Крупные траты (список)"
    hint: "_Транзакции-расходы ≥ {threshold:,} RUB. Они вынесены из \"обычных\" графиков выше._"
    header: "| Счёт | Категория | Сумма | Дата | Комментарий |"
    sep: "|------|-----------|-------|------|-------------|"

  monthly:
    heading: "### По месяцам"
    empty_hint: "_Нет транзакций — записывай в боте, график появится здесь._"

footer:
  refresh: |
    > [!note]- 🔄 Обновить дашборд
    > Из `finance_bot` выполни `./scripts/run_finance_dashboard_daily.sh`

charts:
  daily_categories_file: "Траты_по_дням_категории.png"
  daily_categories_title: "Обычные траты по дням (категории, столбики)"
  oneoff_daily_file: "Разовые_крупные_траты_по_дням.png"
  oneoff_daily_title: "Разовые крупные траты по дням"
  oneoff_series: "Разовые"
  flow_daily_file: "Доход_расход_по_дням.png"
  flow_daily_title: "Доход и расход по дням"
  flow_weekly_file: "Доход_расход_по_неделям.png"
  flow_weekly_title: "Доход и расход по неделям"
  exp_weekly_file: "Траты_по_неделям_категории.png"
  exp_weekly_title: "Обычные траты по неделям (категории, столбики)"
  balance_daily_file: "Суммарный_баланс_по_дням.png"
  balance_daily_title: "Баланс на конец дня: карты, брокер, всего"
  quarterly_file: "Доход_расход_по_кварталам.png"
  quarterly_title: "Доход и расход по кварталам"
  monthly_file: "Доход_расход_по_месяцам.png"
  monthly_title: "Доход и расход по месяцам"
  period_xlabel: "Период"
  income: "Доход"
  expense: "Расход"
  cards_rub: "Карты и кошельки (RUB)"
  broker_rub: "Брокер (RUB)"
  total_rub: "Всего (RUB)"

# 0 = вся история с первой точки данных на графике; >0 — скользящее окно в днях/неделях
chart_windows:
  daily_spending_days: 0
  daily_oneoff_days: 0
  daily_flow_days: 0
  balance_days: 0
  weekly_flow_weeks: 0
  weekly_spending_weeks: 0

category_order:
  - "Еда/Продукты"
  - "Еда/Вне дома"
  - "Еда/Бейдж"
  - "Транспорт/Такси"
  - "Транспорт/Проезд"
  - "Дом/ЖКХ"
  - "Дом/Быт"
  - "Здоровье"
  - "Одежда"
  - "ИТ"
  - "Развитие"
  - "Развлечения"
  - "Подарки"
  - "Подписки"
  - "Прочее"

badge:
  no_account: "_Счёт бейджа ещё не создан — запиши первую трату в боте (🍽 Бейдж)._"
  working_days: "- **Рабочих дней:** {days}"
  spent: "- **Потрачено:** {spent} ₽ из {entitlement} ₽ ({pct:.0f}%)"
  burned: "- **Сгорело квот:** {amount} ₽"
  ndfl: "- **Оценка НДФЛ с трат:** ~{amount} ₽"
  zero_days: "- **Дней без трат (полное сгорение):** {days}"
  over_limit: "- **Сверх дневного лимита:** {amount} ₽"
  chart_file: "Бейдж_утилизация_по_дням.png"
  chart_spent: "Потрачено"
  chart_burned: "Сгорело"
  chart_title: "Бейдж: потрачено и сгоревшая квота по рабочим дням"
  default_title: "🍽 Бейдж питания"

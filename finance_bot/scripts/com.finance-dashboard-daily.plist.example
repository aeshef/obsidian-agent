<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yourname.finance-dashboard-daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>VAULT_PATH="/ABSOLUTE/PATH/TO/Obsidian Vault" "/ABSOLUTE/PATH/TO/runtime/agent/finance_bot/scripts/run_finance_dashboard_daily.sh"</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/runtime/agent/finance_bot/logs/finance_dashboard_daily.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/runtime/agent/finance_bot/logs/finance_dashboard_daily.log</string>
</dict>
</plist>

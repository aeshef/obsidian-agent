# Legacy alias (RU). Prefer kanban_schema.ru.yaml.example / kanban_schema.en.yaml.example
# via scripts/setup/materialize_locale.py → planning_bot/config/kanban_schema.yaml

columns:
  - "📋 Бэклог"
  - "📅 Ждёт даты"
  - "⏸ Отложено"
  - "🔄 В работе"
  - "🚫 Заблокировано"
  - "✅ Сделано"

categories:
  - карьера
  - учеба
  - развитие
  - дом
  - семья
  - здоровье
  - инфраструктура
  - опыт

priorities:
  - высокий
  - средний
  - низкий

category_order:
  карьера: 1
  учеба: 2
  развитие: 3
  здоровье: 4
  инфраструктура: 5
  дом: 6
  семья: 7
  опыт: 8

priority_order:
  высокий: 1
  средний: 2
  низкий: 3

# Optional display glyphs for task lists (override in kanban_schema.yaml).
category_emojis:
  карьера: "💼"
  учеба: "📚"
  развитие: "🚀"
  дом: "🏠"
  семья: "👥"
  здоровье: "💪"
  инфраструктура: "⚙️"
  опыт: "🌟"

priority_emojis:
  высокий: "🔥"
  средний: "🟡"
  низкий: "⚪"

tag_prefixes:
  goal: цель
  priority: приоритет
  focus: фокус
  deadline: дедлайн

# Task block format (used when creating tasks in the board file).
task_meta_template: "\t#цель/{category} #приоритет/{priority}"
task_created_template: "\t📅 Создано: {created_date}"
tag_goal_regex: '#цель/([^\s#]+)'
tag_priority_regex: '#приоритет/(высокий|средний|низкий)'
tag_deadline_regex: '#дедлайн/(\d{4}-\d{2}-\d{2})'
# Goals file tag stripping (locale-aware; used by planning_bot/services/goals.py)
goal_strip_focus_regex: '#(?:фокус|focus)/[^\s#]+'
goal_strip_goal_regex: '#(?:цель|goal)/[^\s#]+'
goal_strip_priority_regex: '#(?:приоритет|priority)/[^\s#]+'
goal_strip_deadline_regex: '#(?:дедлайн|deadline)/[^\s#]+'
goal_focus_quarter_regex_template: '#(?:фокус|focus)/{quarter}\\b'
tag_created_regex: '📅 Создано:\s*(\d{4}-\d{2}-\d{2})'

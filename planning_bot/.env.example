# Скопируй в .env рядом с репозиторием и заполни значения.
# Файл .env в git не коммитится (.gitignore).

# Обязательно
DEEPSEEK_API_TOKEN=
TELEGRAM_PLANNING_BOT_TOKEN=
# Альтернатива: TELEGRAM_BOT_TOKEN=

# Корень Obsidian vault (где лежат 100_Задачи, 200_Цели, …)
VAULT_PATH=

# Опционально
# GOALS_CONTEXT_FILE=/абсолютный/путь/к/личному_goals_context.md
# CHAT_ID_FILE=/абсолютный/путь/к/CHAT_ID.txt

# iPhone-контекст из Gmail IMAP (iphone_mail_sync)
# Настроить App Password: myaccount.google.com → Безопасность → Пароли приложений
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
# Опционально (если нужно изменить):
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_SUBJECT=Контекст_IPhone
# Только письма «за сегодня» по дате заголовка Date (для obsidian_sync по умолч. уже 1):
# IPHONE_MAIL_SYNC_TODAY_ONLY=1
# Часовой пояс для «сегодня» (иначе SERENDIPITY_TZ или Europe/Moscow):
# IPHONE_SYNC_TZ=Europe/Moscow
# Сколько последних календарных дней в Date учитывать (1=только сегодня, 2=сегодня+вчера):
# IPHONE_MAIL_SYNC_RECENT_DAYS=2
# VAULT_PATH: на Mac лучше локальный путь к vault; если путь из .env не существует, config.py подставит путь от репо
# Разово забрать старые письма: IPHONE_MAIL_SYNC_TODAY_ONLY=0 или FORCE_IPHONE_SYNC_ALL_DAYS=1 в obsidian_sync

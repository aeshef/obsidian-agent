# Скопируй в .env и подставь свои значения. Файл .env в git не коммитится.

# Обязательные
TELEGRAM_BOT_TOKEN=123456789:AA...your_token_from_BotFather
DEEPSEEK_API_KEY=sk-...

# Опционально
TIMEZONE=Europe/Moscow
BASE_CURRENCY=RUB
DATABASE_URL=sqlite+aiosqlite:///./finance.db

# Чтобы бот и дашборд смотрели в ОДИН finance.db (иначе бот пишет ./finance.db в каталоге бота, а PNG — из vault):
# 1) Либо абсолютный путь (перекрывает DATABASE_URL):
# FINANCE_DB_PATH=/path/to/Obsidian Vault/300_Дашборды/Данные/finance.db
# 2) Либо корень vault — если файл …/300_Дашборды/Данные/finance.db уже есть, при относительном ./finance.db URL подставится сам:
# VAULT_PATH=/path/to/Obsidian Vault

# Опционально: интеграция Тинькофф Invest API (портфель)
# TINKOFF_API_TOKEN=
# TINKOFF_IGNORE_ACCOUNT_IDS=

# Опционально: модель и ASR
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# ASR_MODEL=small

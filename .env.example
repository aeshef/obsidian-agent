# ─────────────────────────────────────────────────────────────────
# obsidian-agent — единый .env (скопируйте в .env и заполните)
#   cp .env.example .env
# Боты читают этот файл; имена ключей унифицированы (поддержаны и старые алиасы).
# ─────────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────────
VAULT_PATH=/Users/yourname/Documents/Obsidian Vault
# Дефолт в коде — UTC; для MSK задайте:
TIMEZONE=Europe/Moscow
# UI locale: en (default, messages.en.yaml) or ru (messages.ru.yaml)
AGENT_LOCALE=en
# Author full install when capabilities.yaml is absent (all modules/connectors). OSS default: omit or 0.
# OBSIDIAN_AGENT_FULL_INSTALL=1
# Prod prompts: use @cap blocks in *.txt; disable dynamic capability appendix in host_query/health_tools
AGENT_PROMPT_DYNAMIC_SUPPLEMENT=0
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# planning_bot исторически читает DEEPSEEK_API_TOKEN — можно продублировать ключ:
DEEPSEEK_API_TOKEN=sk-...

# ── planning_bot ─────────────────────────────────────────────────
TELEGRAM_PLANNING_BOT_TOKEN=
# iPhone mail IMAP (obsidian_sync шаг 5b.4, только Mac — Gmail App Password)
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_SUBJECT=Контекст_IPhone
# Год целей; если не задан — текущий календарный год
GOALS_YEAR=2026
# Опционально переопределить TZ для календаря/iphone sync:
# CALENDAR_TZ=Europe/Moscow
# SERENDIPITY_TZ=Europe/Moscow
# IPHONE_SYNC_TZ=Europe/Moscow

# ── knowledge_bot ────────────────────────────────────────────────
# Конфиг knowledge_bot (types.yaml, prompts, hubs_registry): по умолчанию knowledge_bot/config.
# Не задавайте AGENT_CONFIG_PATH на несуществующий Agent/config — sync_hubs/retag сломаются.
# AGENT_CONFIG_PATH=/path/to/knowledge_bot/config
TELEGRAM_KNOWLEDGE_BOT_TOKEN=
TELEGRAM_USER_ID=
# my.telegram.org → App api_id/api_hash — для скачивания видео >20 МБ (Telethon MTProto)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Опционально Local Bot API: http://127.0.0.1:8081 + TELEGRAM_LOCAL=1
# TELEGRAM_API_BASE=http://127.0.0.1:8081
YTDLP_ENABLED=1
# Прогрузка: ack каждые N сохранённых заметок (1 = на каждую)
BULK_ACK_EVERY=1
OPENROUTER_API_KEY=
ASR_MODEL=tiny

# ── finance_bot ──────────────────────────────────────────────────
TELEGRAM_FINANCE_BOT_TOKEN=
TINKOFF_API_TOKEN=
TINKOFF_IGNORE_ACCOUNT_IDS=
BASE_CURRENCY=RUB
# FIN_DASHBOARD_START_DATE=2026-02-15  # default: YYYY-01-01 текущего года
# DATABASE_URL=sqlite+aiosqlite:///./finance.db   # canonical: {finance_bot}/finance.db
# FINANCE_DB_PATH=                              # явный абсолютный путь к canonical (опционально)
# FINANCE_USE_VAULT_DB=0                        # legacy: 1 = писать в vault-реплику (не рекомендуется)
# FINANCE_BOT_ROOT=                             # override каталога finance_bot для ./finance.db

# ── unified_bot (рекомендуется для prod и локального запуска) ───
TELEGRAM_UNIFIED_BOT_TOKEN=
DEPLOY_MODE=single

# ── Agent platform (shared/agent) ────────────────────────────────
# ./scripts/setup_agent_config.sh  → config/agent/*.yaml и prompts/*.txt из *.example
# ./scripts/setup.sh также копирует config/messages.ru.yaml и platform.yaml из *.example
# Документация: docs/AGENT_CONFIG.md
# AGENT_DOMAIN=finance          # только для legacy multi-bot (DEPLOY_MODE=multi)
# DEPLOY_MODE=multi             # три отдельных polling-процесса (legacy)
# AGENT_MAX_ITERS=6             # override platform.yaml → agent.max_iters
# AGENT_SESSION_MAX_TURNS=4
# VAULT_REL_KNOWLEDGE=Knowledge   # подкаталог базы знаний в VAULT_PATH (см. platform.yaml.example)

# ── Память: инсайты и синтезатор (shared/memory) ─────────────────
# AGENT_USER_PROFILE=config/agent/user_profile.md   # общий профиль для всех доменов (см. user_profile.md.example)
# AGENT_MEMORY_DB=memory.db                 # SQLite; путь с пробелами — в кавычках: "…/Obsidian Vault/…/memory.db"
# INSIGHTS_CONFIRMATIONS_THRESHOLD=3        # сколько раз паттерн встретился → на верификацию
# INSIGHTS_PENDING_TTL_DAYS=30              # TTL неподтверждённых кандидатов
# SYNTH_ENABLED=0                           # 1 — weekly pattern synth → /memory confirm (LLM cost)
# SYNTH_DOMAINS=finance,planning            # domains for weekly job (Sunday ~04:00)
# KNOWLEDGE_AGENT_WRITES=0                  # 1 — allow append_knowledge_note (allowlisted paths)
# MEMORY_SESSION_PERSIST=1                 # SQLite dialogue history (survives restart)
# MEMORY_WORKING_SET_PERSIST=1             # durable working-set entities (default: follow SESSION)
# AGENT_TRACE=1                            # jsonl cost/latency traces under logs/
# TELEGRAM_UNIFIED_BOT_TOKEN=               # см. блок unified_bot выше
# KANBAN_AGENT_WRITES=1                     # запись доски через apply_kanban_task (иначе только dry-run)

# ── Синхронизация / сервер ───────────────────────────────────────
# SERVER обязателен для scripts/deploy.sh и obsidian_sync.sh
SERVER=your-ssh-host
# SERVER_VAULT=/root/obsidian-vault
# SERVER_BOTS=/root/bots
# LOCAL_VAULT=/same/as/VAULT_PATH
# LAUNCHAGENT_LABEL=com.example.obsidian-sync   # install_launchagent.sh (Mac)
# RSYNC_PUSH_DELETE=1   # Mac→VPS: delete VPS files removed locally (default 1)

# ── Общий fallback токена (если не заданы per-bot) ───────────────
# TELEGRAM_BOT_TOKEN=

# ── knowledge: vision / serendipity / RAG (опционально) ──────────
# OPENROUTER_API_KEY=
# VISION_MODEL=google/gemini-2.5-flash
# SERENDIPITY_ENABLED=1
# AUTHOR_CONTEXT=
# ENABLE_WIKILINKS=1

# ASR HTTP (optional transcription). Knowledge retrieval embeddings use
# OPENROUTER_API_KEY + models.yaml roles.embed (not Ollama).
# ASR_BASE_URL=
# ASR_LANGUAGE=ru,en
# KNOWLEDGE_PRESELECT_BACKEND=dense
# KNOWLEDGE_EMBED_MODEL=openai/text-embedding-3-large
# planning cron на сервере использует SERVER_VAULT как fallback для VAULT_PATH

# ── Feature flags (опционально, для setup/будущих шагов sync) ─────
# ENABLE_PLANNING_BOT=1
# ENABLE_KNOWLEDGE_BOT=1
# ENABLE_FINANCE_BOT=1
# OBSIDIAN_SYNC_VAULT_MAINTENANCE=1
# OBSIDIAN_SYNC_FINANCE_DASHBOARD=1
# OBSIDIAN_SYNC_IPHONE_MAIL=1

# ── Примечание ───────────────────────────────────────────────────
# Все три бота также принимают общий TELEGRAM_BOT_TOKEN как fallback.

# Скопируй в .env и подставь свои значения. Файл .env в git не коммитится.

VAULT_PATH=/path/to/your/Obsidian Vault
TELEGRAM_BOT_TOKEN=123456789:AA...your_token_from_BotFather
TELEGRAM_USER_ID=your_numeric_telegram_id
DEEPSEEK_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-v1-...
# Включить [[wikilinks]] при сохранении заметок (тот же пайплейн, что apply_wikilinks_batch)
ENABLE_WIKILINKS=1

# Опционально:
# VISION_SKIP_IF_ASR_GOOD=1
# YOUTUBE_PROXY=socks5://127.0.0.1:1080
# FORCE_VAULT_MAINTENANCE=1  — в тот же день снова tools/vault_daily_maintenance (obsidian_sync 5b.3)

# Serendipity: 1 раз в сутки в случайный момент (окно по локальному времени) — LLM шлёт в TELEGRAM одну
# заметку (по умолч. из 700/Видео) для «переоткрытия», без хардкода — кандидаты из notes_index + note_hit_stats
# SERENDIPITY_ENABLED=0
# SERENDIPITY_TZ=Europe/Moscow
# SERENDIPITY_HOUR_START=10
# SERENDIPITY_HOUR_END=22
# SERENDIPITY_VIDEO_ONLY=1
# SERENDIPITY_CANDIDATES=45
# SERENDIPITY_REFRESH_INDEX=0   — 1 = перед каждой рассылкой build_or_refresh_index (тяжелее)
# SERENDIPITY_MODEL=deepseek-chat

# Copy to .env.demo (gitignored). Used ONLY by ./scripts/run_unified_bot_demo.sh
# Your real .env stays untouched — demo keys are overlaid in-process after sourcing .env.

AGENT_LOCALE=en
AGENT_EN_STRICT=1
BASE_CURRENCY=USD
FIN_INVESTMENT_EXPENSE_CATEGORIES=Savings
OA_CALENDAR_CLASSIFY=0
FINANCE_CONFIG_DIR="/path/to/obsidian-agent/scripts/demo/finance_config"
VAULT_REL_KNOWLEDGE=Knowledge

# Absolute path to the English synthetic vault:
VAULT_PATH="/path/to/demo-vault-en"
FINANCE_DB_PATH="/path/to/demo-vault-en/300_Dashboards/Data/finance.db"

# Optional: separate Telegram bot token for filming (recommended).
# If unset, the overlay keeps TELEGRAM_* from your real .env.
# TELEGRAM_UNIFIED_BOT_TOKEN=

# Пример crontab для planning_bot на VPS.
# Установка: PLANNING_BOT_ROOT=/opt/obsidian-bots/planning_bot bash scripts/install_planning_crontab.sh
#
# Или вручную (подставьте BOT_ROOT):
# BOT_ROOT=/opt/obsidian-bots/planning_bot
#
# */2 * * * * cd $BOT_ROOT && ./scripts/cron_kanban_monitor.sh >> logs/kanban_monitor.log 2>&1
# 0 1 * * * cd $BOT_ROOT && ./scripts/cron_routines.sh >> logs/routines.log 2>&1
# 0 * * * * cd $BOT_ROOT && ./scripts/run_map_missing_goals.sh >> logs/map_missing_goals.log 2>&1
#
# Примечание: kanban_monitor также может запускаться из in-bot job_queue (planning_bot)
# и из obsidian_sync (Mac→SSH). Держите один канонический источник — см. docs/SCHEDULING.md.

# Author-only vault audit tools (analyze_vault_duplicates.py); optional local override.
# Rules for analyze_vault_duplicates.py / apply_duplicates_resolution.py.
# Extend generic-series detection without hardcoding in Python — edit lists here.

# Substrings in base_slug (stem without _12 suffix): group treated as generic series
generic_slug_substrings:
  - "субтитры"
  - "subtitles"

# Одиночные .md без суффикса _N: stem содержит подстроку → кандидат на удаление,
# если тело заметки не длиннее порога (символов Unicode в теле без frontmatter)
standalone_weak_substrings:
  - "субтитры"
  - "subtitles"
  - "без_названия"

standalone_max_body_chars: 220

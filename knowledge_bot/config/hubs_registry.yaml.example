# cp knowledge_bot/config/hubs_registry.yaml.example knowledge_bot/config/hubs_registry.yaml
# directory подставляется scripts/ensure_hubs_registry.sh из VAULT_REL_KNOWLEDGE / platform.yaml
version: 1
hubs:
  - id: ai-ml
    title: "ИИ, ML и визуальные модели"
    filename: "🗺️_Хаб_AI_и_ML.md"
    directory: "Knowledge/_Хабы"
    include_tags:
      - topic/ai
    include_tag_prefixes:
      - topic/computer-vision
    intro: |
      Автособранный мост к заметкам по ИИ.
    max_notes: 150
    exclude_paths_substr: []
